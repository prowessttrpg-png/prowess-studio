{
  "name": "@prowess/studio",
  "version": "0.1.0",
  "private": true,
  "description": "Prowess Studio — the internal development application (routes, pages, server/API integration, application state). Owns no Prowess mechanical rules.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "echo \"@prowess/studio: no integration tests until M0-WO3 (database)\" && exit 0",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@prowess/model": "workspace:*",
    "@prowess/ui": "workspace:*",
    "dotenv": "18.0.4",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "eslint-config-next": "16.3.6",
    "jsdom": "30.1.1",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
