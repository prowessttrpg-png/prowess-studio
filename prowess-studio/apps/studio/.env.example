# Prowess Studio — environment configuration reference.
#
# .env.development and .env.test already exist with safe, committed local
# defaults — you generally don't need to copy this file for those two
# environments. This file documents every variable and is the starting
# point for production configuration (see .env.production.example for a
# production-shaped copy of the same variables).
#
# Schema and validation: apps/studio/src/config/schema.ts and validate.ts.
# Missing or malformed values fail the app's startup immediately with a
# readable error — see src/config/validate.ts's EnvironmentConfigError.

# One of: development | test | production
# Normally set for you by the tool running the app (next dev/build/start,
# vitest, playwright) — you should not usually set this by hand.
NODE_ENV=development

# The application's own base URL.
APP_URL=http://localhost:3000

# PostgreSQL connection string (postgresql://user:password@host:port/db).
# Shape-validated starting in M0-WO2; not yet consumed by any database
# client — that begins in M0-WO3 (Database & Migration Foundation).
DATABASE_URL=postgresql://user:password@localhost:5432/prowess_studio

# One of: fatal | error | warn | info | debug | trace
LOG_LEVEL=info

# Prowess Studio's own development/debug-mode toggle: "true" or "false"
# ONLY — no other representation is accepted (not "1"/"0", not "yes"/"no",
# and JavaScript truthiness is not used). Deliberately independent of
# NODE_ENV: NODE_ENV picks the runtime environment (which .env file loads,
# how Next.js builds); DEVELOPMENT_MODE picks whether Prowess Studio's own
# development/debug capabilities are enabled. A production deployment could
# in principle run with DEVELOPMENT_MODE=true for internal debugging, so it
# is never inferred from NODE_ENV.
DEVELOPMENT_MODE=true
