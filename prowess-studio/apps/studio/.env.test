# Test defaults. Safe to commit — non-secret, localhost-only placeholder
# values, deliberately distinct from .env.development (different database
# name) so it's obvious which config a given test run picked up.
#
# Loaded automatically when NODE_ENV=test — Vitest sets this itself, and
# Next.js does the same for any `test`-mode invocation. Per Next.js's env
# precedence rules, .env.local is NOT loaded when NODE_ENV=test, which is
# what keeps a developer's personal local overrides from leaking into test
# runs. See PAS-10 §9 acceptance criterion "test configuration loads
# independently".

NODE_ENV=test
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prowess_studio_test
LOG_LEVEL=warn

# Off in the test environment — automated test runs shouldn't depend on
# development/debug-only behavior being enabled.
DEVELOPMENT_MODE=false
