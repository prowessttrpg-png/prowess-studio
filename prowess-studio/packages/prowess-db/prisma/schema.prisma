// Prowess Platform — persistence schema.
//
// M0-WO3 established migration/connection tooling (SystemMigrationProbe,
// below). M1-WO1 adds the first real Prowess domain table: Entity — the
// stable identity layer only (see the Entity model's own doc comment).
// EntityVersion, EntityAlias, Keyword, EntityRelationship, SourceDocument,
// Ruleset, and Spell-specific tables all remain out of scope until their
// own later Work Orders.

generator client {
  // Prisma 7's current generator. "prisma-client-js" (the legacy name) also
  // works, but "prisma-client" is what Prisma's own v7 docs now lead with,
  // and — per that same documentation — EITHER name requires a driver
  // adapter for all databases in v7; there is no generator setting that
  // exempts you from this. See src/client.ts and
  // docs/architecture/database.md's "Prisma 7 requires a driver adapter"
  // note for why @prisma/adapter-pg + pg are real (non-dev) dependencies
  // of this package now, not just a sandbox-verification tool.
  provider = "prisma-client"
  // Required in Prisma 7 — it no longer defaults to node_modules. Resolved
  // relative to this schema file, landing at packages/prowess-db/generated/
  // prisma/ (gitignored — generated code is never committed, same as
  // dist/).
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here — Prisma 7 removed this (see prisma.config.ts alongside
  // this file, and docs/architecture/database.md's "Prisma 7 config-file
  // migration" note for why).
}

/// INTERNAL ONLY — not part of the Prowess domain model.
///
/// Exists solely to give M0-WO3 something concrete to migrate, query,
/// update, delete, and transact against, proving the persistence/migration
/// foundation works before any real Prowess table existed. Now that
/// `Entity` (below) is the first real domain table, this model no longer
/// needs to carry that proving-ground role going forward, but removing it
/// is a separate, deliberate decision (a DROP migration) left for a future
/// Work Order rather than bundled into M1-WO1. Do not build application
/// features against this model, and do not treat it as a template beyond
/// the three conventions it demonstrates:
///   1. UUID primary keys (native Postgres `uuid`, DB-generated)
///   2. `created_at` / `updated_at` timestamps stored as `timestamptz`
///      (timezone-aware — UTC on the wire — never naive local time)
///   3. snake_case column/table names via @map/@@map, matching standard
///      PostgreSQL convention, while Prisma Client still exposes camelCase
///      field names in TypeScript
model SystemMigrationProbe {
  id        String   @id @default(uuid()) @db.Uuid
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("_system_migration_probe")
}

/// Controlled Entity type values (PAS-10 M1-WO1 §6).
///
/// Deliberately the smallest useful Phase 1 set — kept in exact lockstep
/// with @prowess/model's ENTITY_TYPES (packages/prowess-model/src/entity-type.ts),
/// which is the framework-independent source of truth the application
/// layer validates against. Adding a value here always means adding the
/// same value there, and vice versa.
///
/// Anticipated future additions (NOT implemented merely to fill the enum —
/// add only when a concrete Work Order needs them): STAT, SKILL, RACE,
/// WEAPON, ARMOR, MANEUVER, SUMMON, MAGE_ART, PAC, ORGANIZATION, LOCATION,
/// PERSON, CREATURE, WORLD_CONCEPT.
enum EntityType {
  GENERIC_RULE
  SYSTEM
  RESOURCE
  SPELL_EFFECT
  SPELL_TRAIT
  TARGETING
  KEYWORD
}

/// Entity — the stable identity object used throughout Prowess (PAS-10
/// M1-WO1). Represents *what a Prowess concept is*, independent of any
/// particular historical rules/lore version of that concept.
///
/// Deliberately minimal by design. Does NOT and must NEVER contain: a
/// display name, a description, rules text, mechanical values, lore text,
/// a status, a version number, Spell configuration, or any other balance
/// data. All of that belongs on `EntityVersion` (M1-WO2, below), which
/// represents changing/versioned content *about* a stable Entity.
///
/// `createdBy` / `archivedBy`-style audit metadata is deliberately absent:
/// no actor/identity system exists yet in this platform, and inventing a
/// fake ownership column with no real identity behind it would be worse
/// than omitting it. That integration point is left explicit (this note)
/// rather than faked.
model Entity {
  /// Opaque, immutable, DB-generated UUID — the actual relational
  /// identity. Never the canonical key, a name, or an integer sequence.
  id String @id @default(uuid()) @db.Uuid

  entityType EntityType @map("entity_type")

  /// Stable, unique, machine-readable, namespace-aware identity string
  /// (e.g. `spell.effect.damage.direct`). Shape-validated centrally by
  /// @prowess/model's `isValidCanonicalKey` before any value reaches this
  /// column — the database UNIQUE constraint remains the authoritative
  /// guard against duplicates either way (see
  /// packages/prowess-db/src/entity/repository.ts).
  canonicalKey String @unique @map("canonical_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Inverse side of EntityVersion's required relation (M1-WO2). No
  /// `onDelete: Cascade` here — deleting an Entity that has Versions is
  /// restricted at the database level (see EntityVersion.entity below),
  /// not casually destroyed.
  versions EntityVersion[]

  @@map("entities")
}

/// Controlled EntityVersion lifecycle statuses (PAS-10 M1-WO2 §7). M1-WO2
/// establishes this field and its controlled values only — no
/// lifecycle-transition or immutability rules yet (M1-WO3 — e.g. that a
/// `CANON` row can never be edited in place). Kept in exact lockstep with
/// @prowess/model's ENTITY_VERSION_STATUSES
/// (packages/prowess-model/src/status.ts), already defined since M0-WO1.
enum EntityVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PLAYTEST
  CANON
  DEPRECATED
  SUPERSEDED
  ARCHIVED
}

/// Controlled change-metadata classification for EntityVersion (PAS-10
/// M1-WO2 §12). The already-defined PAS-08 architectural change-governance
/// values, reused directly rather than inventing a parallel vocabulary —
/// kept in exact lockstep with @prowess/model's CHANGE_TYPES
/// (packages/prowess-model/src/change-type.ts). The full PAS-08
/// ChangeSet/Canon governance system itself is NOT implemented here; this
/// is only a nullable classification field.
enum ChangeType {
  EDITORIAL
  CLARIFICATION
  PRESENTATION
  MECHANICAL_PATCH
  MECHANICAL_CHANGE
  BREAKING_CHANGE
  CONTENT_ADDITION
  REMOVAL
  RENAME
  RESTRUCTURE
}

/// EntityVersion — the historical/versioned representation of a stable
/// Entity identity (PAS-10 M1-WO2, lifecycle/mutation rules added
/// M1-WO3). See @prowess/model's EntityVersion type
/// (packages/prowess-model/src/entity-version.ts) and
/// docs/architecture/entity-version-lifecycle.md for the full conceptual
/// documentation; this model's shape mirrors it exactly.
///
/// Historical independence and mutability are different concepts: every
/// EntityVersion is independent from every other revision of the same
/// Entity (creating revision 2 never alters revision 1's content) — but
/// that does NOT mean every EntityVersion row is immutable the instant
/// it's created. A `DRAFT` Version is a mutable working revision; once it
/// leaves `DRAFT`, its authored content becomes protected according to the
/// lifecycle rules in @prowess/model's `entity-version-lifecycle.ts`. See
/// `updatedAt` below — M1-WO2 omitted it specifically because this
/// mutation policy hadn't been established yet; M1-WO3 adds it now that it
/// has.
model EntityVersion {
  id String @id @default(uuid()) @db.Uuid

  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Positive, human-readable sequence number — unique per Entity (see the
  /// @@unique below), never the identity. Allocated automatically by
  /// @prowess/db's service layer (max existing + 1); never caller-supplied.
  /// Immutable after creation, even while DRAFT.
  revisionNumber Int @map("revision_number")

  /// Phase 1 lifecycle status (PAS-10 M1-WO3). Changed only through
  /// @prowess/db's dedicated `transitionEntityVersionStatus` — never as a
  /// side effect of a content update (see M1-WO3 §14, "status vs content
  /// mutation are separate operations"). Reaching `CANON` means only that
  /// this Version has reached the CANON lifecycle state — it does NOT mean
  /// this Version is globally "the active Prowess rule." Which exact
  /// EntityVersion is authoritative within a Ruleset is a question later
  /// M2 Ruleset Manifests answer, never a field here.
  status EntityVersionStatus @default(DRAFT)

  /// Human-facing name for THIS Version — lives here, not on Entity,
  /// because terminology may change historically while the Entity
  /// underneath stays the same. Mutable only while `status` is `DRAFT`.
  displayName String @map("display_name")

  shortDescription String? @map("short_description")
  rulesText        String? @map("rules_text")

  /// Variable structured content future subsystem-specific schemas will
  /// validate (e.g. base_mp, damage_parameters) — not implemented yet.
  /// Defaults to an empty JSON object rather than being nullable: every
  /// EntityVersion conceptually "has" structured data (even if empty for
  /// now), so a present-but-empty `{}` is a cleaner default than a
  /// three-state null/empty/populated field for consumers to handle. Must
  /// never become a substitute for relational architecture — Entity
  /// relationships, Keywords, Sources, Rulesets, and aliases all get
  /// dedicated relational models later, never a home in this column.
  structuredData Json @default("{}") @map("structured_data")

  /// Same-Entity lineage only — enforced at the @prowess/db service
  /// boundary (packages/prowess-db/src/entity-version/service.ts), since a
  /// simple foreign key alone cannot express "must belong to the same
  /// entity_id as the referencing row." `onDelete: Restrict` so a Version
  /// with children can't be silently orphaned either. Immutable after
  /// creation (M1-WO3 §4) — not editable even while the child is DRAFT;
  /// draft editing must never rewrite historical ancestry. A protected
  /// (non-DRAFT) Version remains perfectly valid as a parent — see
  /// docs/architecture/entity-version-lifecycle.md's "Child Version from
  /// Protected Version" section.
  parentVersionId String?         @map("parent_version_id") @db.Uuid
  parentVersion   EntityVersion?  @relation("EntityVersionLineage", fields: [parentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  childVersions   EntityVersion[] @relation("EntityVersionLineage")

  /// Lightweight, optional classification — not the full PAS-08
  /// ChangeSet/Canon governance system. Mutable only while `status` is `DRAFT`.
  changeType    ChangeType? @map("change_type")
  changeSummary String?     @map("change_summary")

  /// Immutable after creation — identity/provenance, not authored content.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Added in M1-WO3, once the mutation policy existed to give it meaning.
  /// Updates only when DRAFT content actually changes (via
  /// `updateDraftEntityVersion`) — never implies that a protected,
  /// non-DRAFT Version can be mutated; a protected Version's `updatedAt`
  /// simply stops changing once it leaves DRAFT.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([entityId, revisionNumber])
  @@map("entity_versions")
}
