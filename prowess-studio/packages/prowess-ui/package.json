{
  "name": "@prowess/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared Studio UI primitives. Depends only on React — no Next.js dependency, and no Prowess mechanical rule calculations.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "test:integration": "echo \"@prowess/ui: no integration tests in M0\" && exit 0"
  },
  "peerDependencies": {
    "react": "^19.3.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@types/react": "19.3.0",
    "jsdom": "30.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  }
}
