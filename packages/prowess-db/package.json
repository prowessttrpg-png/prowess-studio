{
  "name": "@prowess/db",
  "version": "0.1.0",
  "private": true,
  "description": "Centralized PostgreSQL persistence boundary (Prisma). Framework-independent domain packages such as @prowess/model must never depend on this package — dependencies point the other way.",
  "type": "module",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src tests --max-warnings=0",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "pnpm run test:unit && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.unit.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prowess/import": "workspace:*",
    "@prowess/model": "workspace:*",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "vitest": "5.0.2",
    "@types/pg": "8.23.1",
    "@types/node": "22.20.4",
    "dotenv": "18.0.4"
  }
}
