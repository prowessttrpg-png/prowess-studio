// Prowess Platform — persistence schema.
//
// M0-WO3 established migration/connection tooling (SystemMigrationProbe,
// below). M1-WO1 adds the first real Prowess domain table: Entity — the
// stable identity layer only (see the Entity model's own doc comment).
// EntityVersion, EntityAlias, Keyword, EntityRelationship, SourceDocument,
// Ruleset, and Spell-specific tables all remain out of scope until their
// own later Work Orders.

generator client {
  // Prisma 7's current generator. "prisma-client-js" (the legacy name) also
  // works, but "prisma-client" is what Prisma's own v7 docs now lead with,
  // and — per that same documentation — EITHER name requires a driver
  // adapter for all databases in v7; there is no generator setting that
  // exempts you from this. See src/client.ts and
  // docs/architecture/database.md's "Prisma 7 requires a driver adapter"
  // note for why @prisma/adapter-pg + pg are real (non-dev) dependencies
  // of this package now, not just a sandbox-verification tool.
  provider = "prisma-client"
  // Required in Prisma 7 — it no longer defaults to node_modules. Resolved
  // relative to this schema file, landing at packages/prowess-db/generated/
  // prisma/ (gitignored — generated code is never committed, same as
  // dist/).
  output = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  // No `url` here — Prisma 7 removed this (see prisma.config.ts alongside
  // this file, and docs/architecture/database.md's "Prisma 7 config-file
  // migration" note for why).
}

// ---------------------------------------------------------------------------
// Id and timestamp defaults — aligned with the approved migrations (M1-WO11, F-1).
//
// Every migration-created UUID primary key has `DEFAULT gen_random_uuid()` in
// PostgreSQL, so the schema declares it as `dbgenerated("gen_random_uuid()")`
// (PostgreSQL generates the id; Prisma Client omits it from the INSERT and reads
// the row back). Declaring it as client-side `uuid()` instead made
// `prisma migrate diff` report the default being dropped on all nine tables.
// `EntityVersion.updatedAt` likewise has `DEFAULT CURRENT_TIMESTAMP` in its
// migration, so it carries `@default(now())` alongside `@updatedAt`.
//
// A blocking CI step runs `prisma migrate diff --exit-code` against a database
// built by `migrate deploy`; any disagreement between this file and the
// migrations fails the build. Do NOT "fix" a future mismatch by editing an
// approved migration — change this file, or add a new migration.
// ---------------------------------------------------------------------------

/// INTERNAL ONLY — not part of the Prowess domain model.
///
/// Exists solely to give M0-WO3 something concrete to migrate, query,
/// update, delete, and transact against, proving the persistence/migration
/// foundation works before any real Prowess table existed. Now that
/// `Entity` (below) is the first real domain table, this model no longer
/// needs to carry that proving-ground role going forward, but removing it
/// is a separate, deliberate decision (a DROP migration) left for a future
/// Work Order rather than bundled into M1-WO1. Do not build application
/// features against this model, and do not treat it as a template beyond
/// the three conventions it demonstrates:
///   1. UUID primary keys (native Postgres `uuid`, DB-generated)
///   2. `created_at` / `updated_at` timestamps stored as `timestamptz`
///      (timezone-aware — UTC on the wire — never naive local time)
///   3. snake_case column/table names via @map/@@map, matching standard
///      PostgreSQL convention, while Prisma Client still exposes camelCase
///      field names in TypeScript
model SystemMigrationProbe {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label     String
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("_system_migration_probe")
}

/// Controlled Entity type values (PAS-10 M1-WO1 §6).
///
/// Deliberately the smallest useful Phase 1 set — kept in exact lockstep
/// with @prowess/model's ENTITY_TYPES (packages/prowess-model/src/entity-type.ts),
/// which is the framework-independent source of truth the application
/// layer validates against. Adding a value here always means adding the
/// same value there, and vice versa.
///
/// Anticipated future additions (NOT implemented merely to fill the enum —
/// add only when a concrete Work Order needs them): STAT, SKILL, RACE,
/// WEAPON, ARMOR, MANEUVER, SUMMON, MAGE_ART, PAC, ORGANIZATION, LOCATION,
/// PERSON, CREATURE, WORLD_CONCEPT.
enum EntityType {
  GENERIC_RULE
  SYSTEM
  RESOURCE
  SPELL_EFFECT
  SPELL_TRAIT
  TARGETING
  KEYWORD
}

/// Entity — the stable identity object used throughout Prowess (PAS-10
/// M1-WO1). Represents *what a Prowess concept is*, independent of any
/// particular historical rules/lore version of that concept.
///
/// Deliberately minimal by design. Does NOT and must NEVER contain: a
/// display name, a description, rules text, mechanical values, lore text,
/// a status, a version number, Spell configuration, or any other balance
/// data. All of that belongs on `EntityVersion` (M1-WO2, below), which
/// represents changing/versioned content *about* a stable Entity.
///
/// `createdBy` / `archivedBy`-style audit metadata is deliberately absent:
/// no actor/identity system exists yet in this platform, and inventing a
/// fake ownership column with no real identity behind it would be worse
/// than omitting it. That integration point is left explicit (this note)
/// rather than faked.
model Entity {
  /// Opaque, immutable, DB-generated UUID — the actual relational
  /// identity. Never the canonical key, a name, or an integer sequence.
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  entityType EntityType @map("entity_type")

  /// Stable, unique, machine-readable, namespace-aware identity string
  /// (e.g. `spell.effect.damage.direct`). Shape-validated centrally by
  /// @prowess/model's `isValidCanonicalKey` before any value reaches this
  /// column — the database UNIQUE constraint remains the authoritative
  /// guard against duplicates either way (see
  /// packages/prowess-db/src/entity/repository.ts).
  canonicalKey String @unique @map("canonical_key")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Inverse side of EntityVersion's required relation (M1-WO2). No
  /// `onDelete: Cascade` here — deleting an Entity that has Versions is
  /// restricted at the database level (see EntityVersion.entity below),
  /// not casually destroyed.
  versions EntityVersion[]

  /// Inverse side of EntityAlias's required relation (M1-WO4). Same
  /// restrictive-deletion posture as `versions` above, for consistency —
  /// see EntityAlias.entity below.
  aliases EntityAlias[]

  /// Inverse side of EntityKeyword's required relation (M1-WO5) — stable-
  /// identity-level Keyword assignments. Same restrictive-deletion
  /// posture as `versions`/`aliases` above.
  keywordAssignments EntityKeyword[]

  /// Inverse sides of EntityRelationship's two required relations (M1-WO6)
  /// — this Entity as the stated SOURCE, and as the stated TARGET, of a
  /// directed relationship. Two separate relation names are required
  /// because EntityRelationship has two distinct foreign keys to this same
  /// model. Same restrictive-deletion posture as every other inverse
  /// relation on this model.
  outgoingRelationships EntityRelationship[] @relation("EntityRelationshipSource")
  incomingRelationships EntityRelationship[] @relation("EntityRelationshipTarget")

  /// Governance conflicts about this Entity (M2-WO5), each scoped to one Ruleset. A relation
  /// list only — no conflict pointer, flag, or winner on the Entity itself.
  ruleConflicts RuleConflict[]

  /// ChangeSet operations proposing something about this Entity (M2-WO7). A relation list only.
  changeSetOperations ChangeSetOperation[]

  /// Migration plan items assessing this Entity (M2-WO11). A relation list only.
  migrationPlanItems MigrationPlanItem[]

  @@map("entities")
}

/// Controlled EntityVersion lifecycle statuses (PAS-10 M1-WO2 §7). M1-WO2
/// establishes this field and its controlled values only — no
/// lifecycle-transition or immutability rules yet (M1-WO3 — e.g. that a
/// `CANON` row can never be edited in place). Kept in exact lockstep with
/// @prowess/model's ENTITY_VERSION_STATUSES
/// (packages/prowess-model/src/status.ts), already defined since M0-WO1.
enum EntityVersionStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PLAYTEST
  CANON
  DEPRECATED
  SUPERSEDED
  ARCHIVED
}

/// Controlled change-metadata classification for EntityVersion (PAS-10
/// M1-WO2 §12). The already-defined PAS-08 architectural change-governance
/// values, reused directly rather than inventing a parallel vocabulary —
/// kept in exact lockstep with @prowess/model's CHANGE_TYPES
/// (packages/prowess-model/src/change-type.ts). The full PAS-08
/// ChangeSet/Canon governance system itself is NOT implemented here; this
/// is only a nullable classification field.
enum ChangeType {
  EDITORIAL
  CLARIFICATION
  PRESENTATION
  MECHANICAL_PATCH
  MECHANICAL_CHANGE
  BREAKING_CHANGE
  CONTENT_ADDITION
  REMOVAL
  RENAME
  RESTRUCTURE
}

/// EntityVersion — the historical/versioned representation of a stable
/// Entity identity (PAS-10 M1-WO2, lifecycle/mutation rules added
/// M1-WO3). See @prowess/model's EntityVersion type
/// (packages/prowess-model/src/entity-version.ts) and
/// docs/architecture/entity-version-lifecycle.md for the full conceptual
/// documentation; this model's shape mirrors it exactly.
///
/// Historical independence and mutability are different concepts: every
/// EntityVersion is independent from every other revision of the same
/// Entity (creating revision 2 never alters revision 1's content) — but
/// that does NOT mean every EntityVersion row is immutable the instant
/// it's created. A `DRAFT` Version is a mutable working revision; once it
/// leaves `DRAFT`, its authored content becomes protected according to the
/// lifecycle rules in @prowess/model's `entity-version-lifecycle.ts`. See
/// `updatedAt` below — M1-WO2 omitted it specifically because this
/// mutation policy hadn't been established yet; M1-WO3 adds it now that it
/// has.
model EntityVersion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Positive, human-readable sequence number — unique per Entity (see the
  /// @@unique below), never the identity. Allocated automatically by
  /// @prowess/db's service layer (max existing + 1); never caller-supplied.
  /// Immutable after creation, even while DRAFT.
  revisionNumber Int @map("revision_number")

  /// Phase 1 lifecycle status (PAS-10 M1-WO3). Changed only through
  /// @prowess/db's dedicated `transitionEntityVersionStatus` — never as a
  /// side effect of a content update (see M1-WO3 §14, "status vs content
  /// mutation are separate operations"). Reaching `CANON` means only that
  /// this Version has reached the CANON lifecycle state — it does NOT mean
  /// this Version is globally "the active Prowess rule." Which exact
  /// EntityVersion is authoritative within a Ruleset is a question later
  /// M2 Ruleset Manifests answer, never a field here.
  status EntityVersionStatus @default(DRAFT)

  /// Human-facing name for THIS Version — lives here, not on Entity,
  /// because terminology may change historically while the Entity
  /// underneath stays the same. Mutable only while `status` is `DRAFT`.
  displayName String @map("display_name")

  shortDescription String? @map("short_description")
  rulesText        String? @map("rules_text")

  /// Variable structured content future subsystem-specific schemas will
  /// validate (e.g. base_mp, damage_parameters) — not implemented yet.
  /// Defaults to an empty JSON object rather than being nullable: every
  /// EntityVersion conceptually "has" structured data (even if empty for
  /// now), so a present-but-empty `{}` is a cleaner default than a
  /// three-state null/empty/populated field for consumers to handle. Must
  /// never become a substitute for relational architecture — Entity
  /// relationships, Keywords, Sources, Rulesets, and aliases all get
  /// dedicated relational models later, never a home in this column.
  structuredData Json @default("{}") @map("structured_data")

  /// Same-Entity lineage only — enforced at the @prowess/db service
  /// boundary (packages/prowess-db/src/entity-version/service.ts), since a
  /// simple foreign key alone cannot express "must belong to the same
  /// entity_id as the referencing row." `onDelete: Restrict` so a Version
  /// with children can't be silently orphaned either. Immutable after
  /// creation (M1-WO3 §4) — not editable even while the child is DRAFT;
  /// draft editing must never rewrite historical ancestry. A protected
  /// (non-DRAFT) Version remains perfectly valid as a parent — see
  /// docs/architecture/entity-version-lifecycle.md's "Child Version from
  /// Protected Version" section.
  parentVersionId String?         @map("parent_version_id") @db.Uuid
  parentVersion   EntityVersion?  @relation("EntityVersionLineage", fields: [parentVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  childVersions   EntityVersion[] @relation("EntityVersionLineage")

  /// Inverse side of EntityVersionKeyword's required relation (M1-WO5) —
  /// Version-level Keyword assignments. Authored assignment/removal is
  /// DRAFT-only, atomically guarded against this row's own `status` — see
  /// packages/prowess-db/src/entity-version-keyword/repository.ts.
  keywordAssignments EntityVersionKeyword[]

  /// Inverse side of SourceReference's required relation (M1-WO7) —
  /// provenance records for where this specific Version's content
  /// originated. Not gated by this Version's own `status` — see
  /// SourceReference's doc comment below for why attaching provenance to
  /// a protected Version is allowed and is not authored content mutation.
  sourceReferences SourceReference[]

  /// Lightweight, optional classification — not the full PAS-08
  /// ChangeSet/Canon governance system. Mutable only while `status` is `DRAFT`.
  changeType    ChangeType? @map("change_type")
  changeSummary String?     @map("change_summary")

  /// Immutable after creation — identity/provenance, not authored content.
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Added in M1-WO3, once the mutation policy existed to give it meaning.
  /// Updates only when DRAFT content actually changes (via
  /// `updateDraftEntityVersion`) — never implies that a protected,
  /// non-DRAFT Version can be mutated; a protected Version's `updatedAt`
  /// simply stops changing once it leaves DRAFT.
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// The manifest entries that pin this exact Version (M2-WO2). A relation list only.
  manifestEntries RulesetManifestEntry[]

  /// The conflict candidates that name this exact Version (M2-WO5). A relation list only:
  /// being a candidate never changes this Version's status or content.
  conflictCandidates RuleConflictCandidate[]

  /// MERGE decisions naming this exact Version as their result (M2-WO6). A relation list only:
  /// being a merge result never changes this Version's status or content.
  mergeResultDecisions CanonDecision[]

  /// ChangeSet operations naming this exact Version as their from / to side (M2-WO7). Relation lists
  /// only: a proposal never changes this Version's status or content.
  changeSetOperationsFrom ChangeSetOperation[] @relation("ChangeSetOperationFrom")
  changeSetOperationsTo   ChangeSetOperation[] @relation("ChangeSetOperationTo")

  /// Migration plan items naming this exact Version on their source / target side (M2-WO11). Relation lists
  /// only: being assessed never changes this Version.
  migrationItemsAsSource MigrationPlanItem[] @relation("MigrationItemSourceVersion")
  migrationItemsAsTarget MigrationPlanItem[] @relation("MigrationItemTargetVersion")

  @@unique([entityId, revisionNumber])
  /// Exists so RulesetManifestEntry can reference (id, entityId) together — a composite
  /// foreign key that makes "Entity A pinned to Entity B's Version" impossible in the
  /// database itself. `id` is already the primary key, so this adds no real constraint
  /// on EntityVersion; it is purely the target of that foreign key.
  @@unique([id, entityId], map: "entity_versions_id_entity_id_key")
  @@map("entity_versions")
}

/// EntityAlias — alternate human-readable lookup/discovery metadata for a
/// stable Entity (PAS-10 M1-WO4). See @prowess/model's EntityAlias type
/// (packages/prowess-model/src/entity-alias.ts) and
/// docs/architecture/entity-alias-model.md for the full conceptual
/// documentation.
///
/// Aliases are NOT a replacement for Entity identity, the canonical key,
/// or EntityVersion.displayName — see the @prowess/model doc comment for
/// why all three answer different questions. No "is_primary" concept
/// exists here, deliberately: the human-facing current/historical name
/// belongs to EntityVersion.displayName, not to a flag on an alias row.
///
/// Deletion is supported (unlike EntityVersion) — aliases are discovery
/// metadata, not historical rule snapshots, so removing one loses nothing
/// that M0/M1's history-preservation principle is protecting.
model EntityAlias {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Authored, exactly as typed — casing/spacing preserved. Never destroyed.
  alias String

  /// `normalizeEntityAlias(alias)` — the lookup/matching form (PAS-10
  /// M1-WO4 §5). Indexed below for exact-match lookup.
  normalizedAlias String @map("normalized_alias")

  /// Authored context exactly as given (e.g. "Affinity", "Organization"),
  /// or `null` if none was supplied. Display/authoring value only — see
  /// `normalizedContext` below for the value actually used in the
  /// uniqueness constraint and lookup matching.
  context String?

  /// Deliberate normalized-context-key strategy (PAS-10 M1-WO4 §9): a
  /// NOT NULL column, defaulting to `""` when no context is supplied,
  /// computed as `normalizeEntityAlias(context ?? "")`. This exists
  /// specifically to avoid a real PostgreSQL pitfall — a UNIQUE constraint
  /// treats NULL as distinct from every other NULL, so two rows with the
  /// same (entityId, normalizedAlias) and BOTH a NULL context would NOT
  /// violate a naive `@@unique([entityId, normalizedAlias, context])`,
  /// silently defeating the duplicate-prevention requirement for the
  /// common no-context case. Using a NOT NULL sentinel instead makes the
  /// constraint behave correctly for every case, context-qualified or not.
  normalizedContext String @default("") @map("normalized_context")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Prevents a normalized duplicate for the same Entity + context (PAS-10
  /// M1-WO4 §8) — deliberately NOT a global unique constraint on
  /// `normalizedAlias` alone, since different Entities may legitimately
  /// share the same alias (e.g. two different "Ward" effects).
  @@unique([entityId, normalizedAlias, normalizedContext], map: "entity_aliases_entity_alias_context_key")
  /// Supports exact-match alias lookup (PAS-10 M1-WO4 §22) — not a
  /// full-text/fuzzy search index; M1-WO4 is exact-match only.
  @@index([normalizedAlias], map: "entity_aliases_normalized_alias_idx")
  @@map("entity_aliases")
}

/// Controlled source classification for a Keyword assignment (PAS-10
/// M1-WO5 §7). AUTHORED is the only value this Work Order's services ever
/// produce — INHERITED and CALCULATED establish architecture for later
/// systems (keeping a dedicated column instead of retrofitting one later)
/// but nothing here automatically creates either kind of row.
enum KeywordAssignmentSource {
  AUTHORED
  INHERITED
  CALCULATED
}

/// KeywordCategory — an organizational grouping for KeywordDefinitions
/// (PAS-10 M1-WO5 §2). Purely organizational; carries no mechanical
/// meaning. See @prowess/model's KeywordCategory type
/// (packages/prowess-model/src/keyword-category.ts) and
/// docs/architecture/keyword-model.md for full documentation.
///
/// No `updatedAt` — M1-WO5 exposes no update operation for
/// KeywordCategory at all (create/get/find-by-key only), so there is
/// nothing yet for it to track. Same reasoning as EntityVersion's
/// originally-omitted `updatedAt` in M1-WO2.
model KeywordCategory {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Reuses the exact same CanonicalKey grammar/validation as Entity and
  /// every other canonical key in this platform — no parallel key format.
  canonicalKey String @unique @map("canonical_key")

  name        String
  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  keywords KeywordDefinition[]

  @@map("keyword_categories")
}

/// KeywordDefinition — the reusable Keyword concept itself (PAS-10 M1-WO5
/// §1, §3–4). A Keyword means ONLY "this object is tagged with this
/// defined concept" — it does NOT implicitly add damage, change MP/AP,
/// trigger a Trait, grant resistance, change targeting, or invoke any
/// other mechanical behavior. No Keyword may acquire unstated mechanical
/// behavior as a side effect of this Work Order; mechanical systems may
/// explicitly query Keywords later. See @prowess/model's KeywordDefinition
/// type and docs/architecture/keyword-model.md for full documentation.
///
/// Distinct from `EntityType.KEYWORD` (M1-WO1) — no `Entity` row is
/// automatically created for a KeywordDefinition here. This model's `id`
/// is the one clear source of Keyword identity for now.
///
/// No `updatedAt` — same reasoning as KeywordCategory above.
model KeywordDefinition {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  /// Reuses CanonicalKey validation — not a Keyword-specific duplicate
  /// validator.
  canonicalKey String @unique @map("canonical_key")

  name String

  /// Zero or one Category — a Keyword may exist uncategorized, to keep
  /// authoring flexible. `onDelete: Restrict`: deleting a Category that
  /// still has Keywords referencing it is rejected outright rather than
  /// cascading or silently nulling every Keyword's category — a Category
  /// in active use is not something an ordinary delete should be able to
  /// quietly unravel.
  categoryId String?          @map("category_id") @db.Uuid
  category   KeywordCategory? @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  description String?

  /// Descriptive metadata ONLY (PAS-10 M1-WO5 §33) — defaults to `false`.
  /// No deprecation mechanics exist in this Work Order: setting this
  /// `true` does not delete, hide, or block assignment of this Keyword.
  /// Governance comes later.
  deprecated Boolean @default(false)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  entityAssignments        EntityKeyword[]
  entityVersionAssignments EntityVersionKeyword[]

  @@index([categoryId], map: "keyword_definitions_category_id_idx")
  @@map("keyword_definitions")
}

/// EntityKeyword — a stable-identity-level Keyword assignment (PAS-10
/// M1-WO5 §5–6, §21). "This Keyword describes the stable identity itself"
/// — e.g. a creature classification, an organization type. Does NOT
/// depend on, or interact with, any EntityVersion's lifecycle status.
///
/// Composite primary key `(entityId, keywordId)` — deliberately no
/// separate synthetic `id` column. The natural key both identifies the
/// assignment AND enforces "a target must not contain the same Keyword
/// twice" as a single database constraint (PAS-10 M1-WO5 §8), rather than
/// a separate uniqueness check layered on top of an otherwise-meaningless
/// id.
///
/// Relational by design: a real foreign key to `Entity`, not a
/// `target_type` + `target_id` polymorphic column — see
/// `EntityVersionKeyword` below and docs/architecture/keyword-model.md for
/// why this repo prefers two explicit assignment models over one
/// polymorphic one.
model EntityKeyword {
  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  keywordId String            @map("keyword_id") @db.Uuid
  keyword   KeywordDefinition @relation(fields: [keywordId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  sourceType KeywordAssignmentSource @map("source_type")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([entityId, keywordId], name: "entityId_keywordId")
  @@index([keywordId], map: "entity_keywords_keyword_id_idx")
  @@map("entity_keywords")
}

/// EntityVersionKeyword — a specific-historical-revision Keyword
/// assignment (PAS-10 M1-WO5 §5–6, §19–20). "This Keyword applies to this
/// specific historical/versioned representation" — e.g. Fire, Ongoing,
/// Zone, Sustained. The preferred home for any Keyword describing
/// mechanics that might change by revision.
///
/// Same composite-primary-key reasoning as `EntityKeyword` above.
///
/// **Lifecycle interaction is enforced in application code, not by this
/// table's own constraints** — authored assignment/removal requires the
/// referenced EntityVersion to be `DRAFT`, checked atomically (a
/// `SELECT ... FOR UPDATE` on the EntityVersion row inside the same
/// transaction as the insert/delete here) by
/// packages/prowess-db/src/entity-version-keyword/repository.ts. A
/// protected (non-DRAFT) Version's Keyword assignments cannot be changed
/// through the supported service boundary, matching M1-WO3's content-
/// mutation rule exactly.
model EntityVersionKeyword {
  entityVersionId String        @map("entity_version_id") @db.Uuid
  entityVersion   EntityVersion @relation(fields: [entityVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  keywordId String            @map("keyword_id") @db.Uuid
  keyword   KeywordDefinition @relation(fields: [keywordId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  sourceType KeywordAssignmentSource @map("source_type")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([entityVersionId, keywordId], name: "entityVersionId_keywordId")
  @@index([keywordId], map: "entity_version_keywords_keyword_id_idx")
  @@map("entity_version_keywords")
}

/// Controlled EntityRelationship type values (PAS-10 M1-WO6 §3). The
/// existing framework-independent vocabulary from M0-WO1
/// (packages/prowess-model/src/relationship-type.ts) already contained
/// exactly the Phase 1 set this Work Order requires — reused verbatim,
/// not duplicated or parallel-invented. Kept in exact lockstep with that
/// file; a test in @prowess/model's relationship-type.test.ts and this
/// Work Order's own unit tests guard against the two drifting apart.
enum RelationshipType {
  REQUIRES
  MODIFIES
  USES
  COMPATIBLE_WITH
  INCOMPATIBLE_WITH
  PART_OF
  BELONGS_TO
  SEE_ALSO
}

/// EntityRelationship — a stable, directed, structural relationship
/// between two Entity identities (PAS-10 M1-WO6). See @prowess/model's
/// EntityRelationship type (packages/prowess-model/src/entity-relationship.ts)
/// and docs/architecture/entity-relationship-model.md for full conceptual
/// documentation.
///
/// **Entity-level scope only** — this does NOT model relationships between
/// specific EntityVersions. Version-sensitive or calculation-bearing
/// relationships belong to dedicated version-scoped models,
/// RequirementDefinition, typed subsystem joins, or Ruleset-specific
/// structures in later Work Orders — never forced into this generic table.
///
/// **No unstated mechanics**, same principle as KeywordDefinition: stating
/// a relationship (even one typed `MODIFIES`) never modifies MP/AP,
/// changes damage, grants a Trait, satisfies a Requirement, determines
/// targeting, alters Character statistics, or activates a rule. This is
/// pure structural/editorial metadata.
///
/// **Directional, stored once.** `sourceEntityId REQUIRES targetEntityId`
/// is one row. Creating it never automatically creates the reverse
/// direction or an inverse-named relationship — see this Work Order's
/// dedicated regression test. The opposite direction (if deliberately
/// authored) is a distinct, independently-stored row.
///
/// Self-relationships (`sourceEntityId === targetEntityId`) are rejected
/// at the @prowess/db service boundary (PAS-10 M1-WO6 §8) — NOT via a
/// database CHECK constraint. This is a deliberate choice: Prisma's schema
/// language has no first-class CHECK-constraint attribute, and hand-adding
/// one directly to a migration's raw SQL (bypassing schema.prisma) risks
/// confusing Prisma's own drift detection on a *future* migration, for a
/// validation this project's established pattern already handles cleanly
/// at the application layer (the same place canonical-key format,
/// display-name non-emptiness, etc. are all validated before anything
/// reaches Prisma).
model EntityRelationship {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceEntityId String @map("source_entity_id") @db.Uuid
  sourceEntity   Entity @relation("EntityRelationshipSource", fields: [sourceEntityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  targetEntityId String @map("target_entity_id") @db.Uuid
  targetEntity   Entity @relation("EntityRelationshipTarget", fields: [targetEntityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  relationshipType RelationshipType @map("relationship_type")

  /// Lightweight, non-authoritative structured context — editorial
  /// qualifiers, notes, future display information. Defaults to an empty
  /// object (same default-not-nullable reasoning as EntityVersion's
  /// structuredData in M1-WO2). MUST NEVER encode actual Prowess rule
  /// calculations (e.g. an `mp_discount` or `damage_bonus` that some
  /// mechanical system then reads and acts on) — calculation-bearing
  /// structures receive dedicated typed models in a later Work Order.
  metadata Json @default("{}")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Prevents an exact duplicate — same source, same target, same type.
  /// Different types between the same pair, and the opposite direction,
  /// are both explicitly allowed (PAS-10 M1-WO6 §9) since neither matches
  /// this triple.
  @@unique([sourceEntityId, targetEntityId, relationshipType], map: "entity_relationships_source_target_type_key")
  @@index([sourceEntityId], map: "entity_relationships_source_entity_id_idx")
  @@index([targetEntityId], map: "entity_relationships_target_entity_id_idx")
  @@map("entity_relationships")
}

/// Controlled SourceDocument type classification (PAS-10 M1-WO7 §3).
/// Deliberately broad — NOT coupled to file extensions/formats; file
/// format parsing belongs to a later M3 Work Order. Descriptive metadata
/// only — creates no authority or import behavior. Kept in exact lockstep
/// with @prowess/model's SOURCE_DOCUMENT_TYPES
/// (packages/prowess-model/src/source-document-type.ts).
enum SourceDocumentType {
  DOCUMENT
  WEB
  OTHER
}

/// Controlled SourceDocument authority classification (PAS-10 M1-WO7 §4),
/// matching the PAS-08 Canon Manager's established vocabulary exactly —
/// not an independently-invented parallel one. Kept in exact lockstep with
/// @prowess/model's SOURCE_AUTHORITY_STATUSES
/// (packages/prowess-model/src/source-authority-status.ts).
///
/// **Descriptive metadata ONLY in M1-WO7.** Setting this does NOT
/// determine Canon, choose a current rule, override a Ruleset, or
/// automatically supersede another document. Nothing in this package reads
/// this field to make any decision — actual source-authority governance
/// belongs to PAS-08/M2's Canon Manager, which does not exist yet.
enum SourceAuthorityStatus {
  GOVERNING
  CURRENT_PRIMARY
  CURRENT_SUPPLEMENTAL
  PLAYTEST_REFERENCE
  HISTORICAL
  SUPERSEDED
  REFERENCE_ONLY
  UNRESOLVED
}

/// SourceDocument — a provenance record for where Prowess content
/// originated (PAS-10 M1-WO7). See @prowess/model's SourceDocument type
/// (packages/prowess-model/src/source-document.ts) and
/// docs/architecture/source-provenance-model.md for full conceptual
/// documentation.
///
/// `title` is human-facing display metadata — never relational identity;
/// there is no canonical-key system for Sources in this Work Order.
/// `fileReference` is an opaque external locator (a Project file id, a
/// document URI, a connector id, a storage key) — no storage provider is
/// assumed, and nothing in this package opens, reads, or parses whatever
/// it references.
///
/// No `updatedAt` — same reasoning as KeywordCategory/KeywordDefinition
/// (M1-WO5): no update operation exists for SourceDocument in this Work
/// Order, so there is nothing yet for it to track.
model SourceDocument {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  title      String
  sourceType SourceDocumentType @map("source_type")

  versionLabel String? @map("version_label")

  /// Descriptive only — see this model's own doc comment above and
  /// SourceAuthorityStatus's doc comment for the full "no implicit
  /// governance" explanation.
  authorityStatus SourceAuthorityStatus? @map("authority_status")

  fileReference String? @map("file_reference")
  notes         String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  references SourceReference[]

  /// Ruleset-scoped authority declarations about this document (M2-WO4). Distinct from the
  /// descriptive `authorityStatus` above, which is never copied into or synchronized with them.
  authorityRecords SourceAuthorityRecord[]

  /// Exact byte revisions of this document (M3-WO1). A relation list only — the document stays the stable
  /// conceptual identity; changed bytes are a NEW Snapshot, never an overwrite.
  snapshots SourceSnapshot[]

  @@map("source_documents")
}

/// SourceReference — a link from a specific EntityVersion to the
/// SourceDocument it was derived from (PAS-10 M1-WO7). See
/// @prowess/model's SourceReference type
/// (packages/prowess-model/src/source-reference.ts) for full conceptual
/// documentation.
///
/// **Attaches to EntityVersion, not stable Entity — deliberately.**
/// Different revisions of the same Entity may derive from different
/// sources; creating a new Version never automatically copies the
/// previous Version's SourceReferences (PAS-10 M1-WO7 §10 — no hidden
/// writes).
///
/// **Not gated by DRAFT/CANON lifecycle status.** Attaching a
/// SourceReference to a protected (non-DRAFT) EntityVersion is allowed and
/// does NOT mutate that Version's `rulesText`, `structuredData`,
/// `displayName`, `status`, or `revisionNumber` — this is separately-
/// managed provenance/audit metadata, not authored mechanical content, so
/// M1-WO3's content-mutation lifecycle rule is deliberately NOT extended
/// to cover it. Later Canon/import governance may impose stricter controls
/// over provenance changes; this Work Order does not anticipate that
/// policy by guessing at it now.
///
/// Both foreign keys use `onDelete: Restrict` — provenance history is
/// never silently lost to an ordinary delete on either side.
///
/// No duplicate-prevention constraint: multiple references from the same
/// EntityVersion to the same SourceDocument may legitimately point to
/// different sections/pages (PAS-10 M1-WO7 §24) — a fragile composite
/// uniqueness rule across nullable locator fields would eliminate
/// superficially-similar-but-legitimately-distinct rows. A future
/// SourceBlock/field-level provenance model can implement more precise
/// identity if that turns out to be needed.
model SourceReference {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceDocumentId String         @map("source_document_id") @db.Uuid
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  entityVersionId String        @map("entity_version_id") @db.Uuid
  entityVersion   EntityVersion @relation(fields: [entityVersionId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Free text, e.g. "Spell AP Cost", "Direct Damage", "Character Creation".
  sectionLabel String? @map("section_label")

  /// TEXT, not an integer — deliberately, so values like "14", "14-16",
  /// "iv", or "Appendix A" are all representable. No page-number
  /// arithmetic is ever performed on this column.
  pageReference String? @map("page_reference")

  /// A short editorial/provenance annotation — NOT the full source text.
  /// This is not a document-copying system; full raw-source preservation
  /// belongs to a later M3 Work Order.
  sourceExcerptNote String? @map("source_excerpt_note")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// M3-WO1 — optional exact location in the structured source layer. All four are NULL for every M1-era
  /// reference, which keeps those rows exactly as valid and readable as before. Composite foreign keys make a
  /// mismatch impossible in the database itself: the Snapshot must be a Snapshot of `sourceDocumentId`, and the
  /// section / block / table must belong to that Snapshot. A CHECK constraint (in the migration; Prisma does not
  /// model CHECK constraints) requires `sourceSnapshotId` whenever a finer locator is set, so MATCH SIMPLE can
  /// never silently skip the composite check.
  sourceSnapshotId String?         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot? @relation(fields: [sourceSnapshotId, sourceDocumentId], references: [id, sourceDocumentId], onDelete: Restrict, onUpdate: Cascade, map: "source_references_snapshot_fkey")

  sourceSectionId String?        @map("source_section_id") @db.Uuid
  sourceSection   SourceSection? @relation(fields: [sourceSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_references_section_fkey")

  sourceBlockId String?      @map("source_block_id") @db.Uuid
  sourceBlock   SourceBlock? @relation(fields: [sourceBlockId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_references_block_fkey")

  sourceTableId String?      @map("source_table_id") @db.Uuid
  sourceTable   SourceTable? @relation(fields: [sourceTableId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_references_table_fkey")

  /// Conflict candidates citing this reference as evidence (M2-WO5). A relation list only.
  conflictCandidates RuleConflictCandidate[]

  /// Exists so RuleConflictCandidate can reference (id, entityVersionId) together (M2-WO5) — a
  /// composite foreign key that makes "a candidate for Version A cites Version B's reference"
  /// impossible in the database itself. `id` is already the primary key, so this adds no real
  /// constraint on SourceReference; it is purely the target of that foreign key.
  @@unique([id, entityVersionId], map: "source_references_id_entity_version_id_key")
  @@index([sourceDocumentId], map: "source_references_source_document_id_idx")
  @@index([entityVersionId], map: "source_references_entity_version_id_idx")
  @@index([sourceSnapshotId], map: "source_references_source_snapshot_id_idx")
  @@index([sourceSectionId], map: "source_references_source_section_id_idx")
  @@index([sourceBlockId], map: "source_references_source_block_id_idx")
  @@index([sourceTableId], map: "source_references_source_table_id_idx")
  @@map("source_references")
}

/// Governance lifecycle of a Ruleset (PAS-10 M2-WO1 §6). Deliberately its OWN
/// vocabulary, not EntityVersionStatus — they describe different lifecycles.
/// Descriptive only: a status never makes an EntityVersion Canon or selects
/// content. Kept in lockstep with @prowess/model's RULESET_STATUSES
/// (packages/prowess-model/src/ruleset-status.ts); the static audit enforces it.
enum RulesetStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  DEPRECATED
  ARCHIVED
}

/// Release channel of a Ruleset (PAS-08 alignment) — classification metadata
/// only. It does not publish, select EntityVersions, change Canon, or alter any
/// mechanic. Kept in lockstep with @prowess/model's RULESET_CHANNELS
/// (packages/prowess-model/src/ruleset-channel.ts).
enum RulesetChannel {
  DEVELOPMENT
  INTERNAL_PLAYTEST
  CORE_PLAYTEST
  EXPERIMENTAL
  STABLE
  LEGACY
}

/// Ruleset — the stable identity and governance lifecycle of a named rules
/// configuration (PAS-10 M2-WO1). See docs/architecture/ruleset-foundation.md.
///
/// Holds NO content and references NO Entity or EntityVersion: which
/// EntityVersion applies under a Ruleset will be pinned explicitly by a future
/// RulesetManifest (M2-WO2), never derived from latest revision, CANON status,
/// revision number, or Source authority. There is deliberately no
/// current/active/latest anything on this table.
///
/// `parentRulesetId` is lineage metadata only (future inheritance) and is chosen
/// at creation; nothing resolves content through it. ON DELETE RESTRICT: a parent
/// cannot be physically deleted while children exist.
model Ruleset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  canonicalKey String @unique @map("canonical_key")

  name        String
  description String?

  status  RulesetStatus  @default(DRAFT)
  channel RulesetChannel

  /// A human-facing label ("0.1", "Core Playtest 2026.10"); never parsed as semver.
  versionLabel String? @map("version_label")

  parentRulesetId String?   @map("parent_ruleset_id") @db.Uuid
  parent          Ruleset?  @relation("RulesetLineage", fields: [parentRulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  children        Ruleset[] @relation("RulesetLineage")

  /// The composition snapshots of this Ruleset (M2-WO2). A relation list only —
  /// there is deliberately NO current/active/published manifest pointer here.
  manifests RulesetManifest[]

  /// The source-authority policy snapshots of this Ruleset (M2-WO4). A relation list only —
  /// there is deliberately NO current/active policy pointer here.
  canonPolicies CanonPolicy[]

  /// Governance conflicts recorded in this Ruleset's context (M2-WO5). A relation list only —
  /// a conflict never changes this Ruleset's status, manifests, or policies.
  ruleConflicts RuleConflict[]

  /// Canon decisions recorded in this Ruleset's context (M2-WO6). A relation list only — a decision
  /// never changes this Ruleset's status, manifests, or policies.
  canonDecisions CanonDecision[]

  /// Proposed ChangeSets in this Ruleset's context (M2-WO7). A relation list only — a proposal never
  /// changes this Ruleset.
  changeSets ChangeSet[]

  /// Published history (M2-WO8). A relation list only — there is NO current/active release pointer;
  /// "latest" is the highest release_number, computed only when explicitly asked.
  releases RulesetRelease[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([parentRulesetId], map: "rulesets_parent_ruleset_id_idx")
  /// Import Batches naming this Ruleset as REVIEW CONTEXT only (M3-WO2) — never a destination or anything mutated.
  importBatches ImportBatch[]

  @@map("rulesets")
}

/// RulesetManifest — an immutable historical SNAPSHOT of a Ruleset's composition
/// (PAS-10 M2-WO2). See docs/architecture/ruleset-manifest.md.
///
/// A Ruleset has many manifests over time; changing a composition means creating
/// a NEW manifest, never editing one — so there is no updatedAt. `manifestVersion`
/// (1, 2, 3 … per Ruleset) is allocated automatically with a bounded retry, and
/// UNIQUE(ruleset_id, manifest_version) is the final authority. There is
/// deliberately no current/active/published flag or pointer anywhere: the
/// numerically highest manifest is only ever "the Latest Manifest", a
/// deterministic convenience that says nothing about which composition is in force.
///
/// ON DELETE RESTRICT: a Ruleset cannot be physically deleted while manifests exist.
model RulesetManifest {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  rulesetId String  @map("ruleset_id") @db.Uuid
  ruleset   Ruleset @relation(fields: [rulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Inheritance (M2-WO3): the EXACT manifest — which must belong to this Ruleset's
  /// DIRECT parent Ruleset — from which Entities this manifest does not pin may be
  /// inherited, or NULL for "this manifest inherits nothing". Chosen at creation and
  /// never changed. It is a snapshot reference, never "the parent's latest manifest",
  /// so a newer parent manifest can never alter an existing child's composition.
  /// A plain foreign key cannot prove the parent belongs to the parent RULESET, so
  /// the service enforces that; ON DELETE RESTRICT keeps an inherited manifest from
  /// disappearing while a child references it.
  parentManifestId String?           @map("parent_manifest_id") @db.Uuid
  parentManifest   RulesetManifest?  @relation("ManifestInheritance", fields: [parentManifestId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  childManifests   RulesetManifest[] @relation("ManifestInheritance")

  /// Positive, unique within the Ruleset, never supplied by callers. Positivity is
  /// guaranteed by the allocator (always >= 1) and pinned by tests, following M1's
  /// convention (no CHECK constraints in this schema).
  manifestVersion Int @map("manifest_version")

  entries RulesetManifestEntry[]

  /// ChangeSet operations that analyzed this exact manifest (M2-WO7). A relation list only: a proposal
  /// never edits a manifest — an applied change will create a NEW one.
  changeSetOperations ChangeSetOperation[]

  /// Releases whose composition IS this manifest (M2-WO8). A relation list only.
  releases RulesetRelease[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Import Batches pinning this exact Manifest as a historical comparison baseline (M3-WO2). A relation list only.
  importBatches ImportBatch[]

  @@unique([rulesetId, manifestVersion], map: "ruleset_manifests_ruleset_id_manifest_version_key")
  /// Target of ChangeSetOperation's composite key (M2-WO7): an analyzed manifest belongs to the ChangeSet's
  /// Ruleset. Adds no real constraint: `id` is the primary key.
  @@unique([id, rulesetId], map: "ruleset_manifests_id_ruleset_id_key")
  @@index([parentManifestId], map: "ruleset_manifests_parent_manifest_id_idx")
  @@map("ruleset_manifests")
}

/// RulesetManifestEntry — one pin: "within this manifest, use exactly this
/// EntityVersion for this Entity" (PAS-10 M2-WO2). It never means "the latest
/// Version from now on", and nothing here consults status, Source authority,
/// Keywords, or relationships.
///
/// The core invariant — the Version belongs to the Entity — is enforced by the
/// database: the foreign key is COMPOSITE, (entity_version_id, entity_id) →
/// entity_versions(id, entity_id). That single constraint also guarantees the
/// Entity exists, which is why there is no separate foreign key to `entities`
/// (and so no overlapping second relation on entityId).
///
/// UNIQUE(manifest_id, entity_id): a manifest pins one Version per Entity.
/// Every foreign key is ON DELETE RESTRICT: historical composition is never
/// cascade-deleted, and a pinned Version / its Entity / the manifest / the
/// Ruleset cannot be physically deleted while an entry references it.
model RulesetManifestEntry {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  manifestId String          @map("manifest_id") @db.Uuid
  manifest   RulesetManifest @relation(fields: [manifestId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  entityId        String        @map("entity_id") @db.Uuid
  entityVersionId String        @map("entity_version_id") @db.Uuid
  entityVersion   EntityVersion @relation(fields: [entityVersionId, entityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([manifestId, entityId], map: "ruleset_manifest_entries_manifest_id_entity_id_key")
  @@index([entityVersionId], map: "ruleset_manifest_entries_entity_version_id_idx")
  @@index([entityId], map: "ruleset_manifest_entries_entity_id_idx")
  @@map("ruleset_manifest_entries")
}

/// CanonPolicy — an immutable historical SNAPSHOT of how authoritative each SourceDocument
/// is within one Ruleset (PAS-10 M2-WO4). See docs/architecture/canon-policy-source-authority.md.
///
/// A Ruleset has many policies over time; to change source authority you create policy
/// N+1, never edit one — so there is no updatedAt. `policyVersion` (1, 2, 3 … per Ruleset)
/// is allocated automatically with a bounded retry, and UNIQUE(ruleset_id, policy_version)
/// is the final authority. There is deliberately no current/active policy flag or pointer
/// anywhere: the highest policy_version is only ever "the Latest Canon Policy", a
/// deterministic convenience. A policy is GOVERNANCE METADATA ONLY — it never selects an
/// EntityVersion, alters a manifest, or makes anything Canon.
///
/// ON DELETE RESTRICT: a Ruleset cannot be physically deleted while policies exist.
model CanonPolicy {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  rulesetId String  @map("ruleset_id") @db.Uuid
  ruleset   Ruleset @relation(fields: [rulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  /// Positive, unique within the Ruleset, never supplied by callers. Positivity is
  /// guaranteed by the allocator (always >= 1) and pinned by tests, following M1's
  /// convention (no CHECK constraints in this schema).
  policyVersion Int @map("policy_version")

  name        String
  description String?

  authorityRecords SourceAuthorityRecord[]

  /// Decisions made under this exact snapshot (M2-WO6). A relation list only: being cited never
  /// changes a policy or its records.
  canonDecisions CanonDecision[]

  /// Releases published under this exact snapshot (M2-WO8). A relation list only.
  releases RulesetRelease[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([rulesetId, policyVersion], map: "canon_policies_ruleset_id_policy_version_key")
  /// Target of CanonDecision's composite key (M2-WO6) — makes "a decision for Ruleset A under
  /// Ruleset B's policy" impossible in the database. Adds no real constraint: `id` is the primary key.
  @@unique([id, rulesetId], map: "canon_policies_id_ruleset_id_key")
  @@map("canon_policies")
}

/// SourceAuthorityRecord — "in this policy, this SourceDocument has this authority within
/// this scope" (PAS-10 M2-WO4). It belongs to exactly one CanonPolicy snapshot and references
/// a SourceDocument; it does NOT attach to an Entity, EntityVersion, or SourceReference.
///
/// `authorityStatus` reuses the existing SourceAuthorityStatus enum (no second vocabulary),
/// and is deliberately independent of SourceDocument.authorityStatus: the document's own
/// field is descriptive provenance, this one is Ruleset-scoped governance. They are never
/// copied or synchronized. `scopeKey` is `global` or a dotted machine-readable scope such as
/// `entity_type.spell_effect`; UNIQUE(canon_policy_id, source_document_id, scope_key) allows
/// one declaration per document per scope per policy. A missing declaration is NOT stored as
/// an UNRESOLVED row — "no authority declared" is derived on lookup.
///
/// Both foreign keys are ON DELETE RESTRICT: governance history is never cascade-deleted.
model SourceAuthorityRecord {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  canonPolicyId String      @map("canon_policy_id") @db.Uuid
  canonPolicy   CanonPolicy @relation(fields: [canonPolicyId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  sourceDocumentId String         @map("source_document_id") @db.Uuid
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  scopeKey        String                @map("scope_key")
  authorityStatus SourceAuthorityStatus @map("authority_status")
  rationale       String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([canonPolicyId, sourceDocumentId, scopeKey], map: "source_authority_records_policy_source_scope_key")
  @@index([sourceDocumentId], map: "source_authority_records_source_document_id_idx")
  @@map("source_authority_records")
}

/// What kind of disagreement a RuleConflict records (PAS-10 M2-WO5 §5). Classification only:
/// no value carries behavior. Kept in lockstep with @prowess/model's RULE_CONFLICT_TYPES
/// (packages/prowess-model/src/rule-conflict-type.ts); the static audit enforces it.
enum RuleConflictType {
  SOURCE_CONTRADICTION
  MECHANICAL_DIVERGENCE
  TERMINOLOGY_DIVERGENCE
  STRUCTURAL_DIVERGENCE
  AUTHORING_STANDARD_CONFLICT
  OTHER
}

/// Review priority of a RuleConflict (PAS-10 M2-WO5 §6). Governance metadata only: it never
/// selects a candidate, blocks resolution, or changes a Ruleset, manifest, policy, or Version.
/// Kept in lockstep with @prowess/model's RULE_CONFLICT_SEVERITIES.
enum RuleConflictSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// Governance state of a RuleConflict (PAS-10 M2-WO5 §7, §8). M2-WO5 creates every conflict
/// OPEN and offers no transition; M2-WO6 (Canon Decisions) owns how a conflict reaches the
/// other states. ACCEPTED_DIVERGENCE = the difference is intentional and both forms stay
/// valid in distinct Ruleset contexts. Kept in lockstep with @prowess/model's RULE_CONFLICT_STATUSES.
enum RuleConflictStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  ACCEPTED_DIVERGENCE
  DISMISSED
}

/// RuleConflict — an explicit, historically reproducible record that exact historical rule
/// representations disagree and need governance review (PAS-10 M2-WO5).
/// See docs/architecture/rule-conflicts.md.
///
/// It RECORDS a disagreement; it never RESOLVES one. There is deliberately no winner,
/// selected/resolved candidate, decision, resolution text, or resolved_at column — M2-WO6's
/// CanonDecision owns outcomes. Creating one changes no manifest, inheritance result,
/// EntityVersion status, or CanonPolicy, and it carries no canon_policy_id: the policy
/// snapshot a decision relies on is recorded by that decision, not pinned before review.
///
/// Ruleset-scoped (the same Versions may conflict in one Ruleset and not another) and
/// single-Entity. No updatedAt: no edit operation exists. `status` defaults to OPEN and no
/// operation changes it in M2-WO5.
///
/// UNIQUE(id, entity_id) adds no real constraint (id is the primary key); it is the target of
/// the candidates' composite foreign key, which is how the database guarantees every
/// candidate concerns this conflict's Entity. Both foreign keys are ON DELETE RESTRICT:
/// governance history is never cascade-deleted.
model RuleConflict {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  rulesetId String  @map("ruleset_id") @db.Uuid
  ruleset   Ruleset @relation(fields: [rulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  conflictType RuleConflictType     @map("conflict_type")
  severity     RuleConflictSeverity
  status       RuleConflictStatus   @default(OPEN)

  title       String
  description String?

  candidates RuleConflictCandidate[]

  /// The decisions about this conflict (M2-WO6). Normal flow yields at most one (a decided conflict is
  /// terminal); no UNIQUE(rule_conflict_id) is imposed so future explicit rollback / supersession can
  /// add history. A relation list only.
  canonDecisions CanonDecision[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([id, entityId], map: "rule_conflicts_id_entity_id_key")
  /// Target of CanonDecision's composite key (M2-WO6): a decision's Ruleset and Entity are pinned to
  /// its conflict's. Adds no real constraint: `id` is the primary key.
  @@unique([id, rulesetId, entityId], map: "rule_conflicts_id_ruleset_id_entity_id_key")
  @@index([rulesetId, entityId], map: "rule_conflicts_ruleset_id_entity_id_idx")
  @@index([rulesetId, status], map: "rule_conflicts_ruleset_id_status_idx")
  @@index([entityId], map: "rule_conflicts_entity_id_idx")
  @@map("rule_conflicts")
}

/// RuleConflictCandidate — one exact historical EntityVersion participating in a conflict
/// (PAS-10 M2-WO5). Never "latest", "CANON", or "current": an exact Version id, so a later
/// revision is never silently added to an existing conflict.
///
/// `entityId` is a REDUNDANT copy of the conflict's Entity, kept for one reason: database
/// enforcement of "every candidate Version belongs to the conflict's Entity". Two composite
/// foreign keys pin it from both sides, so it cannot diverge:
///   (rule_conflict_id, entity_id)   -> rule_conflicts(id, entity_id)    it IS the conflict's Entity
///   (entity_version_id, entity_id)  -> entity_versions(id, entity_id)   the Version belongs to it
/// The service always writes it from the conflict and validates first; the foreign keys are
/// the final authority.
///
/// Optional evidence: (source_reference_id, entity_version_id) -> source_references(id,
/// entity_version_id) means a cited SourceReference must belong to THIS candidate's Version.
/// With no reference (NULL), PostgreSQL's MATCH SIMPLE skips that check — provenance is
/// optional because conflicts may come from playtest or design review. `label` and
/// `positionSummary` are editorial review aids, never mechanics. No source-authority status is
/// copied here: authority never ranks candidates.
///
/// UNIQUE(rule_conflict_id, entity_version_id): a Version appears at most once per conflict.
/// The "at least two candidates" rule spans rows, so the service enforces it inside the
/// creating transaction (no trigger). Every foreign key is ON DELETE RESTRICT.
model RuleConflictCandidate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  ruleConflictId String       @map("rule_conflict_id") @db.Uuid
  entityId       String       @map("entity_id") @db.Uuid
  ruleConflict   RuleConflict @relation(fields: [ruleConflictId, entityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade, map: "rule_conflict_candidates_conflict_entity_fkey")

  entityVersionId String        @map("entity_version_id") @db.Uuid
  entityVersion   EntityVersion @relation(fields: [entityVersionId, entityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade, map: "rule_conflict_candidates_version_entity_fkey")

  sourceReferenceId String?          @map("source_reference_id") @db.Uuid
  sourceReference   SourceReference? @relation(fields: [sourceReferenceId, entityVersionId], references: [id, entityVersionId], onDelete: Restrict, onUpdate: Cascade, map: "rule_conflict_candidates_source_reference_fkey")

  label           String?
  positionSummary String? @map("position_summary")

  /// Decisions that selected this exact candidate (M2-WO6). A relation list only.
  decisionSelections CanonDecisionSelection[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([ruleConflictId, entityVersionId], map: "rule_conflict_candidates_conflict_version_key")
  /// Target of CanonDecisionSelection's composite key (M2-WO6): a selected candidate must belong to the
  /// decision's conflict. Adds no real constraint: `id` is the primary key.
  @@unique([id, ruleConflictId], map: "rule_conflict_candidates_id_rule_conflict_id_key")
  @@index([entityVersionId], map: "rule_conflict_candidates_entity_version_id_idx")
  @@index([sourceReferenceId], map: "rule_conflict_candidates_source_reference_id_idx")
  @@map("rule_conflict_candidates")
}

/// What governance action a CanonDecision records (PAS-10 M2-WO6 §6) — the conflict-resolution subset of
/// PAS-08's vocabulary. Records only: no value executes rule behavior. Kept in lockstep with
/// @prowess/model's CANON_DECISION_TYPES (packages/prowess-model/src/canon-decision-type.ts).
enum CanonDecisionType {
  SELECT_RULE
  KEEP_SEPARATE
  MERGE
  RESOLVE_CONFLICT
}

/// The terminal RuleConflict status a decision produces (PAS-10 M2-WO6 §7, §8); each value maps to the
/// RuleConflictStatus of the same name. Kept in lockstep with @prowess/model's CANON_CONFLICT_DISPOSITIONS.
enum CanonConflictDisposition {
  RESOLVED
  ACCEPTED_DIVERGENCE
  DISMISSED
}

/// CanonDecision — an immutable, auditable governance outcome for exactly one RuleConflict, decided under
/// exactly one CanonPolicy snapshot (PAS-10 M2-WO6). See docs/architecture/canon-decisions.md.
///
/// Records; never applies. Creating one changes no manifest, inheritance result, EntityVersion status,
/// CanonPolicy, or Ruleset — the ONLY side effect is the conflict's status moving to
/// `conflict_disposition`, in the same transaction. No updated_at, winner, active/current/latest flag, or
/// applied-manifest column: a decision is never edited, and applying it belongs to later ChangeSets.
///
/// Integrity, all in the database (composite foreign keys, the M2-WO2/WO5 pattern):
///   (rule_conflict_id, ruleset_id, entity_id) -> rule_conflicts(id, ruleset_id, entity_id)
///       the decision's Ruleset and Entity ARE its conflict's
///   (canon_policy_id, ruleset_id) -> canon_policies(id, ruleset_id)
///       the policy belongs to that same Ruleset
///   (result_entity_version_id, entity_id) -> entity_versions(id, entity_id)
///       a MERGE result belongs to the conflict's Entity (NULL = no result; MATCH SIMPLE skips the check)
/// `entity_id` is a redundant integrity column, always written from the conflict and pinned by the first
/// key, so it cannot diverge; it is not part of the domain shape.
///
/// No UNIQUE(rule_conflict_id): the service allows one decision per OPEN/UNDER_REVIEW conflict via an
/// atomic conditional status transition, and future explicit rollback/supersession may add history.
/// Every foreign key is ON DELETE RESTRICT.
model CanonDecision {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  rulesetId String  @map("ruleset_id") @db.Uuid
  ruleset   Ruleset @relation(fields: [rulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  entityId String @map("entity_id") @db.Uuid

  ruleConflictId String       @map("rule_conflict_id") @db.Uuid
  ruleConflict   RuleConflict @relation(fields: [ruleConflictId, rulesetId, entityId], references: [id, rulesetId, entityId], onDelete: Restrict, onUpdate: Cascade, map: "canon_decisions_conflict_fkey")

  canonPolicyId String      @map("canon_policy_id") @db.Uuid
  canonPolicy   CanonPolicy @relation(fields: [canonPolicyId, rulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "canon_decisions_policy_fkey")

  decisionType        CanonDecisionType        @map("decision_type")
  conflictDisposition CanonConflictDisposition @map("conflict_disposition")

  resultEntityVersionId String?        @map("result_entity_version_id") @db.Uuid
  resultEntityVersion   EntityVersion? @relation(fields: [resultEntityVersionId, entityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade, map: "canon_decisions_result_version_fkey")

  rationale String

  selections CanonDecisionSelection[]

  /// ChangeSets this decision motivated (M2-WO7). A relation list only: linking never modifies a decision.
  changeSets ChangeSet[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// Target of CanonDecisionSelection's composite key. Adds no real constraint: `id` is the primary key.
  @@unique([id, ruleConflictId], map: "canon_decisions_id_rule_conflict_id_key")
  /// Target of ChangeSet's composite key (M2-WO7): a linked decision belongs to the ChangeSet's Ruleset.
  /// Adds no real constraint: `id` is the primary key.
  @@unique([id, rulesetId], map: "canon_decisions_id_ruleset_id_key")
  @@index([rulesetId], map: "canon_decisions_ruleset_id_idx")
  @@index([ruleConflictId], map: "canon_decisions_rule_conflict_id_idx")
  @@index([canonPolicyId], map: "canon_decisions_canon_policy_id_idx")
  @@index([resultEntityVersionId], map: "canon_decisions_result_entity_version_id_idx")
  @@map("canon_decisions")
}

/// CanonDecisionSelection — one exact RuleConflictCandidate a decision selected (SELECT_RULE), kept
/// (KEEP_SEPARATE), merged (MERGE), or cited (RESOLVE_CONFLICT) (PAS-10 M2-WO6). Never a "latest" Version.
///
/// `rule_conflict_id` is a redundant integrity column, always written from the decision. Two composite
/// foreign keys pin it from both sides, so "decision for Conflict A selects Conflict B's candidate" is
/// impossible to store and the copy cannot diverge:
///   (canon_decision_id, rule_conflict_id)          -> canon_decisions(id, rule_conflict_id)
///   (rule_conflict_candidate_id, rule_conflict_id) -> rule_conflict_candidates(id, rule_conflict_id)
/// UNIQUE(canon_decision_id, rule_conflict_candidate_id): a candidate appears once per decision.
model CanonDecisionSelection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  canonDecisionId String        @map("canon_decision_id") @db.Uuid
  ruleConflictId  String        @map("rule_conflict_id") @db.Uuid
  canonDecision   CanonDecision @relation(fields: [canonDecisionId, ruleConflictId], references: [id, ruleConflictId], onDelete: Restrict, onUpdate: Cascade, map: "canon_decision_selections_decision_fkey")

  ruleConflictCandidateId String                @map("rule_conflict_candidate_id") @db.Uuid
  ruleConflictCandidate   RuleConflictCandidate @relation(fields: [ruleConflictCandidateId, ruleConflictId], references: [id, ruleConflictId], onDelete: Restrict, onUpdate: Cascade, map: "canon_decision_selections_candidate_fkey")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([canonDecisionId, ruleConflictCandidateId], map: "canon_decision_selections_decision_candidate_key")
  @@index([ruleConflictCandidateId], map: "canon_decision_selections_candidate_id_idx")
  @@map("canon_decision_selections")
}

/// Lifecycle vocabulary of a ChangeSet (PAS-10 M2-WO7 §3). Every ChangeSet is created DRAFT and M2-WO7 offers
/// no transition; the review/publishing workflow (M2-WO8) owns the rest. Kept in lockstep with
/// @prowess/model's CHANGE_SET_STATUSES.
enum ChangeSetStatus {
  DRAFT
  READY_FOR_REVIEW
  APPROVED
  REJECTED
  SUPERSEDED
}

/// What one ChangeSetOperation PROPOSES (PAS-10 M2-WO7 §7). Never executed by M2-WO7. Kept in lockstep with
/// @prowess/model's CHANGE_SET_OPERATION_TYPES.
enum ChangeSetOperationType {
  PIN_ENTITY_VERSION
  REPLACE_ENTITY_VERSION
  ADD_ENTITY_TO_MANIFEST
  REMOVE_ENTITY_FROM_MANIFEST
  CREATE_ENTITY_VERSION
  DEPRECATE_ENTITY_VERSION
  NO_CHANGE
}

/// ChangeSet — an immutable PROPOSAL of exact repository/ruleset changes (PAS-10 M2-WO7).
/// See docs/architecture/change-sets-impact-analysis.md.
///
/// It mutates nothing — no Entity, Version, Ruleset, manifest, policy, conflict, decision, authority record,
/// keyword, relationship or source. Created DRAFT, never edited (no updated_at): revise by creating another.
/// No applied / executed / release column: application belongs to M2-WO8.
///
/// (canon_decision_id, ruleset_id) -> canon_decisions(id, ruleset_id): a linked decision belongs to the
/// same Ruleset (NULL = no link; MATCH SIMPLE skips the check). UNIQUE(id, ruleset_id) adds no real
/// constraint; it is the target of the operations' composite key. Every foreign key is ON DELETE RESTRICT.
model ChangeSet {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  rulesetId String  @map("ruleset_id") @db.Uuid
  ruleset   Ruleset @relation(fields: [rulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  canonDecisionId String?        @map("canon_decision_id") @db.Uuid
  canonDecision   CanonDecision? @relation(fields: [canonDecisionId, rulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "change_sets_canon_decision_fkey")

  name        String
  description String?
  status      ChangeSetStatus @default(DRAFT)

  operations ChangeSetOperation[]

  /// The release that applied this ChangeSet (M2-WO8). At most one: ruleset_releases.change_set_id is UNIQUE.
  releases RulesetRelease[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([id, rulesetId], map: "change_sets_id_ruleset_id_key")
  @@index([rulesetId], map: "change_sets_ruleset_id_idx")
  @@index([canonDecisionId], map: "change_sets_canon_decision_id_idx")
  @@map("change_sets")
}

/// ChangeSetOperation — one exact proposed change (PAS-10 M2-WO7). Which ids are present depends on
/// operation_type (the validation matrix in @prowess/model's CHANGE_SET_OPERATION_RULES). Every Version is
/// an exact id. `sequence` preserves the author's order (all rows of one transaction share created_at).
///
/// Integrity, in the database (composite foreign keys, the M2 pattern):
///   (change_set_id, ruleset_id)             -> change_sets(id, ruleset_id)          ruleset_id IS the ChangeSet's
///   (target_manifest_id, ruleset_id)        -> ruleset_manifests(id, ruleset_id)    analyzed manifest is in that Ruleset
///   (from_entity_version_id, target_entity_id) -> entity_versions(id, entity_id)     from Version belongs to the target
///   (to_entity_version_id, target_entity_id)   -> entity_versions(id, entity_id)     to Version belongs to the target
/// `ruleset_id` is a redundant integrity column, always written from the ChangeSet and pinned by the first
/// key. A NULL manifest/version skips its check (MATCH SIMPLE). The service guarantees a Version is never
/// named without its target Entity (the matrix requires target_entity_id whenever a Version is allowed).
/// target_manifest_id records ANALYSIS context — the manifest is never edited. Every key is ON DELETE RESTRICT.
model ChangeSetOperation {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  changeSetId String    @map("change_set_id") @db.Uuid
  rulesetId   String    @map("ruleset_id") @db.Uuid
  changeSet   ChangeSet @relation(fields: [changeSetId, rulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "change_set_operations_change_set_fkey")

  sequence      Int
  operationType ChangeSetOperationType @map("operation_type")

  targetEntityId String? @map("target_entity_id") @db.Uuid
  targetEntity   Entity? @relation(fields: [targetEntityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "change_set_operations_target_entity_fkey")

  fromEntityVersionId String?        @map("from_entity_version_id") @db.Uuid
  fromEntityVersion   EntityVersion? @relation("ChangeSetOperationFrom", fields: [fromEntityVersionId, targetEntityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade, map: "change_set_operations_from_version_fkey")

  toEntityVersionId String?        @map("to_entity_version_id") @db.Uuid
  toEntityVersion   EntityVersion? @relation("ChangeSetOperationTo", fields: [toEntityVersionId, targetEntityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade, map: "change_set_operations_to_version_fkey")

  targetManifestId String?          @map("target_manifest_id") @db.Uuid
  targetManifest   RulesetManifest? @relation(fields: [targetManifestId, rulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "change_set_operations_target_manifest_fkey")

  description String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([changeSetId, sequence], map: "change_set_operations_change_set_id_sequence_key")
  @@index([targetEntityId], map: "change_set_operations_target_entity_id_idx")
  @@index([fromEntityVersionId], map: "change_set_operations_from_entity_version_id_idx")
  @@index([toEntityVersionId], map: "change_set_operations_to_entity_version_id_idx")
  @@index([targetManifestId], map: "change_set_operations_target_manifest_id_idx")
  @@map("change_set_operations")
}

/// RulesetRelease — immutable published history (PAS-10 M2-WO8). See docs/architecture/ruleset-publishing-releases.md.
///
/// Born published: no updated_at, draft state, or current/active flag. Pins EXACTLY the Ruleset, a NEW flattened
/// parentless manifest (its composition), the governing CanonPolicy, the applied ChangeSet (optional), a per-Ruleset
/// release_number and version_label, the Ruleset's channel at publication (the existing RulesetChannel enum — no
/// second channel vocabulary), and the SHA-256 of the canonical composition (PROWESS_MANIFEST_V1).
///
/// Same-Ruleset integrity is enforced by composite keys onto the existing PK-led targets:
///   (manifest_id, ruleset_id)     -> ruleset_manifests(id, ruleset_id)
///   (canon_policy_id, ruleset_id) -> canon_policies(id, ruleset_id)
///   (change_set_id, ruleset_id)   -> change_sets(id, ruleset_id)      (NULL = no ChangeSet; MATCH SIMPLE)
/// UNIQUE(ruleset_id, release_number), UNIQUE(ruleset_id, version_label), UNIQUE(change_set_id) (one release per
/// ChangeSet in Phase 1; NULLs never collide). Every foreign key is ON DELETE RESTRICT; no delete operation exists.
model RulesetRelease {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  rulesetId String  @map("ruleset_id") @db.Uuid
  ruleset   Ruleset @relation(fields: [rulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  releaseNumber Int            @map("release_number")
  versionLabel  String         @map("version_label")
  channel       RulesetChannel

  manifestId String          @map("manifest_id") @db.Uuid
  manifest   RulesetManifest @relation(fields: [manifestId, rulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "ruleset_releases_manifest_fkey")

  canonPolicyId String      @map("canon_policy_id") @db.Uuid
  canonPolicy   CanonPolicy @relation(fields: [canonPolicyId, rulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "ruleset_releases_policy_fkey")

  changeSetId String?    @map("change_set_id") @db.Uuid
  changeSet   ChangeSet? @relation(fields: [changeSetId, rulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "ruleset_releases_change_set_fkey")

  manifestHash String  @map("manifest_hash")
  releaseNotes String? @map("release_notes")

  /// Migration plans assessing this exact Release as source / target (M2-WO11). Relation lists only: an
  /// assessment never modifies, archives, deprecates or hides a Release.
  migrationPlansAsSource MigrationPlan[] @relation("MigrationPlanSourceRelease")
  migrationPlansAsTarget MigrationPlan[] @relation("MigrationPlanTargetRelease")

  publishedAt DateTime @default(now()) @map("published_at") @db.Timestamptz(6)

  @@unique([rulesetId, releaseNumber], map: "ruleset_releases_ruleset_id_release_number_key")
  @@unique([rulesetId, versionLabel], map: "ruleset_releases_ruleset_id_version_label_key")
  @@unique([changeSetId], map: "ruleset_releases_change_set_id_key")
  @@index([manifestId], map: "ruleset_releases_manifest_id_idx")
  @@index([canonPolicyId], map: "ruleset_releases_canon_policy_id_idx")
  @@map("ruleset_releases")
}

/// Structural change of one Entity between two exact Release compositions (PAS-10 M2-WO11 §5). Kept in lockstep with
/// @prowess/model's MIGRATION_CHANGE_TYPES.
enum MigrationChangeType {
  UNCHANGED
  ADDED_ENTITY
  REMOVED_ENTITY
  CHANGED_VERSION
}

/// The PAS-08 compatibility vocabulary (PAS-10 M2-WO11 §6), declared in full; WO11 assigns only UNCHANGED and
/// REVIEW_REQUIRED. Kept in lockstep with @prowess/model's MIGRATION_COMPATIBILITY_CLASSIFICATIONS.
enum MigrationCompatibilityClassification {
  UNCHANGED
  RECALCULATE_ONLY
  VALID_WITH_CHANGES
  REVIEW_REQUIRED
  INVALID
  UNSUPPORTED
}

/// MigrationPlan — an immutable, historical assessment of two EXACT published Releases (PAS-10 M2-WO11).
/// See docs/architecture/ruleset-migration-legacy.md. Planning only: no applied / current / active / complete column,
/// no updated_at, and nothing ever executes a plan. The Releases' hashes are recorded as verified at creation.
/// Every foreign key is ON DELETE RESTRICT.
model MigrationPlan {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceReleaseId String         @map("source_release_id") @db.Uuid
  sourceRelease   RulesetRelease @relation("MigrationPlanSourceRelease", fields: [sourceReleaseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "migration_plans_source_release_fkey")

  targetReleaseId String         @map("target_release_id") @db.Uuid
  targetRelease   RulesetRelease @relation("MigrationPlanTargetRelease", fields: [targetReleaseId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "migration_plans_target_release_fkey")

  sourceManifestHash String @map("source_manifest_hash")
  targetManifestHash String @map("target_manifest_hash")

  name        String
  description String?

  items MigrationPlanItem[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([sourceReleaseId], map: "migration_plans_source_release_id_idx")
  @@index([targetReleaseId], map: "migration_plans_target_release_id_idx")
  @@map("migration_plans")
}

/// MigrationPlanItem — one Entity's structural change within a plan (PAS-10 M2-WO11). At most one per Entity per plan.
/// Version references are composite keys onto entity_versions(id, entity_id), so a referenced Version must belong to
/// the item's Entity (NULL = absent on that side; MATCH SIMPLE skips the check). Which side is NULL follows the change
/// type exactly (ADDED: source NULL; REMOVED: target NULL; CHANGED: both, different; UNCHANGED: both, equal) — the
/// service computes items, they are never caller-supplied. Every foreign key is ON DELETE RESTRICT.
model MigrationPlanItem {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  migrationPlanId String        @map("migration_plan_id") @db.Uuid
  migrationPlan   MigrationPlan @relation(fields: [migrationPlanId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "migration_plan_items_plan_fkey")

  entityId String @map("entity_id") @db.Uuid
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "migration_plan_items_entity_fkey")

  sourceEntityVersionId String?        @map("source_entity_version_id") @db.Uuid
  sourceEntityVersion   EntityVersion? @relation("MigrationItemSourceVersion", fields: [sourceEntityVersionId, entityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade, map: "migration_plan_items_source_version_fkey")

  targetEntityVersionId String?        @map("target_entity_version_id") @db.Uuid
  targetEntityVersion   EntityVersion? @relation("MigrationItemTargetVersion", fields: [targetEntityVersionId, entityId], references: [id, entityId], onDelete: Restrict, onUpdate: Cascade, map: "migration_plan_items_target_version_fkey")

  changeType                  MigrationChangeType                  @map("change_type")
  compatibilityClassification MigrationCompatibilityClassification @map("compatibility_classification")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([migrationPlanId, entityId], map: "migration_plan_items_plan_entity_key")
  @@index([entityId], map: "migration_plan_items_entity_id_idx")
  @@index([sourceEntityVersionId], map: "migration_plan_items_source_entity_version_id_idx")
  @@index([targetEntityVersionId], map: "migration_plan_items_target_entity_version_id_idx")
  @@map("migration_plan_items")
}

// ---------------------------------------------------------------------------
// M3-WO1 — Structured source layer.
//
//   SourceDocument -> SourceSnapshot -> { SourceSection, SourceContentNode -> Block | Table | AssetPlacement }
//
// Every table below is INSERT-ONLY: no update or delete service exists. Every child carries its Snapshot id, and
// every reference between structure rows is a COMPOSITE foreign key over (id, source_snapshot_id), so structure
// from one Snapshot can never reference structure from another — enforced by PostgreSQL, not just the service.
// All foreign keys are ON DELETE RESTRICT. "Source structure records what a source says and where it says it. It
// does not determine whether that source is Canon." Nothing here is game-semantic. See
// docs/architecture/m3-source-structure.md.
// ---------------------------------------------------------------------------

/// Structural block kinds (M3-WO1). Never game-semantic. Lockstep with @prowess/model SOURCE_BLOCK_TYPES.
enum SourceBlockType {
  HEADING
  PARAGRAPH
  LIST_ITEM
  CAPTION
  PREFORMATTED
  OTHER
}

/// What a content node targets (M3-WO1). Lockstep with @prowess/model SOURCE_CONTENT_NODE_TYPES.
enum SourceContentNodeType {
  BLOCK
  TABLE
  ASSET_PLACEMENT
}

/// Embedded asset kinds (M3-WO1). Lockstep with @prowess/model SOURCE_ASSET_TYPES.
enum SourceAssetType {
  IMAGE
  EMBEDDED_OBJECT
  OTHER
}

/// Where a page location came from (M3-WO1): stated by the source, or unavailable (all page fields NULL).
/// There is deliberately no "estimated" value. Lockstep with @prowess/model SOURCE_PAGE_LOCATION_BASES.
enum SourcePageLocationBasis {
  SOURCE_NATIVE
  UNAVAILABLE
}

/// One exact revision of a SourceDocument's bytes (M3-WO1). Identified by (sourceDocumentId, contentHash): the
/// same bytes for the same document are one Snapshot; changed bytes are a new one. The bytes themselves are not
/// stored in the database — `contentHash` + `byteSize` identify them exactly. Declared version / draft state are
/// what the source says about itself and are descriptive only: they never imply authority or Canon status.
model SourceSnapshot {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceDocumentId String         @map("source_document_id") @db.Uuid
  sourceDocument   SourceDocument @relation(fields: [sourceDocumentId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_snapshots_document_fkey")

  label              String
  originalFilename   String  @map("original_filename")
  mimeType           String  @map("mime_type")
  contentHash        String  @map("content_hash")
  byteSize           Int     @map("byte_size")
  pageCount          Int?    @map("page_count")
  declaredVersion    String? @map("declared_version")
  declaredDraftState String? @map("declared_draft_state")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  ingestion        SourceSnapshotIngestion?
  sections         SourceSection[]
  blocks           SourceBlock[]
  tables           SourceTable[]
  assets           SourceAsset[]
  assetPlacements  SourceAssetPlacement[]
  contentNodes     SourceContentNode[]
  sourceReferences SourceReference[]

  /// Import Batches run against this exact Snapshot (M3-WO2). A relation list only.
  importBatches        ImportBatch[]
  extractionCandidates ExtractionCandidate[]
  candidateSources     ExtractionCandidateSource[]

  @@unique([sourceDocumentId, contentHash], map: "source_snapshots_document_content_hash_key")
  /// Target of SourceReference's composite key: a reference's Snapshot must belong to the reference's document.
  @@unique([id, sourceDocumentId], map: "source_snapshots_id_document_key")
  @@map("source_snapshots")
}

/// The one-and-only record that a Snapshot's structure was ingested (M3-WO1). UNIQUE per Snapshot: a second
/// ingestion can never be inserted, which is what makes a Snapshot immutable after structural ingestion without
/// any row ever being updated. Written in the SAME transaction as the structure itself.
model SourceSnapshotIngestion {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @unique(map: "source_snapshot_ingestions_snapshot_key") @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_snapshot_ingestions_snapshot_fkey")

  parserName    String @map("parser_name")
  parserVersion String @map("parser_version")
  structureHash String @map("structure_hash")
  sectionCount  Int    @map("section_count")
  nodeCount     Int    @map("node_count")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  importBatches ImportBatch[]

  /// Target of ImportBatch's composite key (M3-WO2): a Batch can only pin a structure hash this Snapshot was
  /// actually ingested with. `source_snapshot_id` is already unique, so this adds no real constraint.
  @@unique([sourceSnapshotId, structureHash], map: "source_snapshot_ingestions_snapshot_structure_hash_key")
  @@map("source_snapshot_ingestions")
}

/// A heading-delimited section of one Snapshot (M3-WO1), nested via `parentSectionId`. The parent must be a
/// section of the SAME Snapshot (composite self-reference).
model SourceSection {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_sections_snapshot_fkey")

  parentSectionId String?         @map("parent_section_id") @db.Uuid
  parentSection   SourceSection?  @relation("SourceSectionNesting", fields: [parentSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_sections_parent_fkey")
  childSections   SourceSection[] @relation("SourceSectionNesting")

  title             String
  headingLevel      Int                     @map("heading_level")
  ordinal           Int
  startPage         Int?                    @map("start_page")
  endPage           Int?                    @map("end_page")
  pageLocationBasis SourcePageLocationBasis @map("page_location_basis")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  blocks           SourceBlock[]
  tables           SourceTable[]
  assetPlacements  SourceAssetPlacement[]
  contentNodes     SourceContentNode[]
  sourceReferences SourceReference[]

  /// M3-WO2 back-relations (lists only).
  importBatchScopes    ImportBatch[]
  primaryForCandidates ExtractionCandidate[]
  candidateSources     ExtractionCandidateSource[]

  @@unique([id, sourceSnapshotId], map: "source_sections_id_snapshot_key")
  @@unique([sourceSnapshotId, ordinal], map: "source_sections_snapshot_ordinal_key")
  @@index([parentSectionId], map: "source_sections_parent_section_id_idx")
  @@map("source_sections")
}

/// A structural text block of one Snapshot (M3-WO1). `rawText` is the source's text verbatim and is never
/// replaced by `normalizedText` (a convenience view, NULL when identical).
model SourceBlock {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_blocks_snapshot_fkey")

  sourceSectionId String?        @map("source_section_id") @db.Uuid
  sourceSection   SourceSection? @relation(fields: [sourceSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_blocks_section_fkey")

  blockType         SourceBlockType         @map("block_type")
  ordinal           Int
  rawText           String                  @map("raw_text")
  normalizedText    String?                 @map("normalized_text")
  sourceStyle       String?                 @map("source_style")
  listLevel         Int?                    @map("list_level")
  listOrdered       Boolean?                @map("list_ordered")
  pageStart         Int?                    @map("page_start")
  pageEnd           Int?                    @map("page_end")
  pageLocationBasis SourcePageLocationBasis @map("page_location_basis")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// At most one element: `block_id` / `table_id` is UNIQUE on source_content_nodes (a relation list only
  /// because the foreign key is composite).
  contentNodes     SourceContentNode[]
  sourceReferences SourceReference[]

  @@unique([id, sourceSnapshotId], map: "source_blocks_id_snapshot_key")
  @@unique([sourceSnapshotId, ordinal], map: "source_blocks_snapshot_ordinal_key")
  @@index([sourceSectionId], map: "source_blocks_source_section_id_idx")
  @@map("source_blocks")
}

/// A table of one Snapshot (M3-WO1), kept STRUCTURED: `structureJson` preserves row / column / cell order and
/// represents headers, row spans and column spans. `rawText` is an optional plain rendering, never a replacement.
model SourceTable {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_tables_snapshot_fkey")

  sourceSectionId String?        @map("source_section_id") @db.Uuid
  sourceSection   SourceSection? @relation(fields: [sourceSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_tables_section_fkey")

  ordinal           Int
  caption           String?
  pageStart         Int?                    @map("page_start")
  pageEnd           Int?                    @map("page_end")
  pageLocationBasis SourcePageLocationBasis @map("page_location_basis")
  structureJson     Json                    @map("structure_json")
  rawText           String?                 @map("raw_text")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// At most one element: `block_id` / `table_id` is UNIQUE on source_content_nodes (a relation list only
  /// because the foreign key is composite).
  contentNodes     SourceContentNode[]
  sourceReferences SourceReference[]

  @@unique([id, sourceSnapshotId], map: "source_tables_id_snapshot_key")
  @@unique([sourceSnapshotId, ordinal], map: "source_tables_snapshot_ordinal_key")
  @@index([sourceSectionId], map: "source_tables_source_section_id_idx")
  @@map("source_tables")
}

/// An embedded asset of one Snapshot (M3-WO1) — an image or embedded object, represented explicitly and never
/// analysed. Identified within the Snapshot by its content hash: the same bytes placed twice are one asset with
/// two placements. Bytes are not stored in the database (hash + size identify them).
model SourceAsset {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_assets_snapshot_fkey")

  assetType         SourceAssetType @map("asset_type")
  mimeType          String          @map("mime_type")
  contentHash       String          @map("content_hash")
  byteSize          Int             @map("byte_size")
  width             Int?
  height            Int?
  sourceFilename    String?         @map("source_filename")
  caption           String?
  altTextFromSource String?         @map("alt_text_from_source")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  placements SourceAssetPlacement[]

  @@unique([id, sourceSnapshotId], map: "source_assets_id_snapshot_key")
  @@unique([sourceSnapshotId, contentHash], map: "source_assets_snapshot_content_hash_key")
  @@map("source_assets")
}

/// Where an asset appears in one Snapshot (M3-WO1). Carries its Snapshot id so the asset, section and content
/// node it relates to are all provably of the SAME Snapshot (composite keys).
model SourceAssetPlacement {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_asset_placements_snapshot_fkey")

  sourceAssetId String      @map("source_asset_id") @db.Uuid
  sourceAsset   SourceAsset @relation(fields: [sourceAssetId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_asset_placements_asset_fkey")

  sourceSectionId String?        @map("source_section_id") @db.Uuid
  sourceSection   SourceSection? @relation(fields: [sourceSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_asset_placements_section_fkey")

  ordinal           Int
  pageNumber        Int?                    @map("page_number")
  pageLocationBasis SourcePageLocationBasis @map("page_location_basis")
  altTextFromSource String?                 @map("alt_text_from_source")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// At most one element: `asset_placement_id` is UNIQUE on source_content_nodes.
  contentNodes SourceContentNode[]

  @@unique([id, sourceSnapshotId], map: "source_asset_placements_id_snapshot_key")
  @@unique([sourceSnapshotId, ordinal], map: "source_asset_placements_snapshot_ordinal_key")
  @@index([sourceAssetId], map: "source_asset_placements_source_asset_id_idx")
  @@index([sourceSectionId], map: "source_asset_placements_source_section_id_idx")
  @@map("source_asset_placements")
}

/// The ordered document flow of one Snapshot (M3-WO1): blocks, tables and asset placements interleaved exactly
/// as in the source. Exactly one target, matching `nodeType` — enforced by a CHECK constraint in the migration
/// (Prisma does not model CHECK constraints) as well as by the service. Each target appears in the flow at most
/// once (unique), and every target and section is of the SAME Snapshot (composite keys).
model SourceContentNode {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "source_content_nodes_snapshot_fkey")

  sourceSectionId String?        @map("source_section_id") @db.Uuid
  sourceSection   SourceSection? @relation(fields: [sourceSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_content_nodes_section_fkey")

  ordinal  Int
  nodeType SourceContentNodeType @map("node_type")

  blockId String?      @unique(map: "source_content_nodes_block_key") @map("block_id") @db.Uuid
  block   SourceBlock? @relation(fields: [blockId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_content_nodes_block_fkey")

  tableId String?      @unique(map: "source_content_nodes_table_key") @map("table_id") @db.Uuid
  table   SourceTable? @relation(fields: [tableId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_content_nodes_table_fkey")

  assetPlacementId String?               @unique(map: "source_content_nodes_asset_placement_key") @map("asset_placement_id") @db.Uuid
  assetPlacement   SourceAssetPlacement? @relation(fields: [assetPlacementId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "source_content_nodes_asset_placement_fkey")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  /// M3-WO2 back-relations (lists only).
  primaryForCandidates ExtractionCandidate[]
  candidateSources     ExtractionCandidateSource[]

  /// Target of the M3-WO2 candidate anchor composite keys: an anchored node must be of the candidate's Snapshot.
  @@unique([id, sourceSnapshotId], map: "source_content_nodes_id_snapshot_key")
  @@unique([sourceSnapshotId, ordinal], map: "source_content_nodes_snapshot_ordinal_key")
  @@index([sourceSectionId], map: "source_content_nodes_source_section_id_idx")
  @@map("source_content_nodes")
}

// ---------------------------------------------------------------------------
// M3-WO2 — Import Batches & Extraction Candidates.
//
//   SourceSnapshot -> ImportBatch -> ExtractionCandidate (UNREVIEWED) -> ExtractionCandidateSource (supporting)
//
// INSERT-ONLY in WO2: no update or delete service exists. Every structural anchor is a COMPOSITE foreign key over
// (id, source_snapshot_id), and every child repeats its Batch's Snapshot through a composite key, so no Batch or
// Candidate can reference structure of another Snapshot. All foreign keys are ON DELETE RESTRICT. CHECK constraints
// (scope shape, comparison context, exactly-one anchor, positive ordinals) live in the migration and are pinned by
// the M3 static audit. Candidates are proposals only — see docs/architecture/m3-import-batches-candidates.md.
// ---------------------------------------------------------------------------

/// What part of a Snapshot a Batch covers (M3-WO2). Lockstep with @prowess/model IMPORT_BATCH_SCOPE_TYPES.
enum ImportBatchScopeType {
  SNAPSHOT
  SECTION_SUBTREE
}

/// Batch lifecycle (M3-WO2). RESERVED: WO2 writes only CREATED; transitions belong to WO3 / WO6.
/// Lockstep with @prowess/model IMPORT_BATCH_STATUSES.
enum ImportBatchStatus {
  CREATED
  EXTRACTING
  READY_FOR_REVIEW
  REVIEWING
  COMPLETED
  FAILED
  CANCELLED
}

/// Generic extraction kinds (M3-WO2) — never game-specific. Lockstep with @prowess/model EXTRACTION_CANDIDATE_KINDS.
enum ExtractionCandidateKind {
  ENTITY
  ENTITY_FIELD
  FORMULA
  REQUIREMENT
  KEYWORD
  RELATIONSHIP
  REFERENCE
  UNKNOWN
}

/// How confident the EXTRACTION was (M3-WO2). NOT source authority. Lockstep with @prowess/model EXTRACTION_CONFIDENCES.
enum ExtractionConfidence {
  HIGH
  MEDIUM
  LOW
}

/// The PAS-07 candidate vocabulary (M3-WO2). WO2 writes only UNREVIEWED. APPROVED (future) means "approved by import
/// review", never Canon. Lockstep with @prowess/model EXTRACTION_CANDIDATE_STATUSES.
enum ExtractionCandidateStatus {
  UNREVIEWED
  MATCHED
  NEW_ENTITY
  CONFLICT
  NEEDS_MAPPING
  REJECTED
  APPROVED
}

/// One reproducible extraction attempt against ONE exact, structurally-ingested SourceSnapshot (M3-WO2).
/// `(sourceSnapshotId, sourceStructureHash)` is a composite key onto the Snapshot's ingestion record, so a Batch can
/// exist only for an ingested Snapshot and only with the hash it was actually ingested with. Review Ruleset /
/// comparison Manifest are exact historical CONTEXT ONLY; the Manifest must belong to that Ruleset (composite key).
/// `batchFingerprint` (PROWESS_IMPORT_BATCH_V1) is the Batch's extraction identity; label/description are not part of it.
model ImportBatch {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "import_batches_snapshot_fkey")

  sourceStructureHash String                  @map("source_structure_hash")
  sourceIngestion     SourceSnapshotIngestion @relation(fields: [sourceSnapshotId, sourceStructureHash], references: [sourceSnapshotId, structureHash], onDelete: Restrict, onUpdate: Cascade, map: "import_batches_structure_hash_fkey")

  label       String
  description String?

  scopeType      ImportBatchScopeType @map("scope_type")
  scopeSectionId String?              @map("scope_section_id") @db.Uuid
  scopeSection   SourceSection?       @relation(fields: [scopeSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "import_batches_scope_section_fkey")

  reviewRulesetId String?  @map("review_ruleset_id") @db.Uuid
  reviewRuleset   Ruleset? @relation(fields: [reviewRulesetId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "import_batches_review_ruleset_fkey")

  comparisonManifestId String?          @map("comparison_manifest_id") @db.Uuid
  comparisonManifest   RulesetManifest? @relation(fields: [comparisonManifestId, reviewRulesetId], references: [id, rulesetId], onDelete: Restrict, onUpdate: Cascade, map: "import_batches_comparison_manifest_fkey")

  extractorKey        String  @map("extractor_key")
  extractorVersion    String  @map("extractor_version")
  extractorConfigHash String? @map("extractor_config_hash")

  batchFingerprint String @unique(map: "import_batches_batch_fingerprint_key") @map("batch_fingerprint")

  status ImportBatchStatus @default(CREATED)

  /// M3-WO3 extraction workflow fields — set exactly once, in the same transaction that commits the Candidate set
  /// and moves the Batch to READY_FOR_REVIEW. `extractionOutputHash` (PROWESS_EXTRACTION_SET_V1) pins which immutable
  /// Candidates the Batch produced; `extractedAt` is metadata only. CHECK constraints (in the migration) tie both to
  /// the status: null while CREATED / EXTRACTING, present from READY_FOR_REVIEW on.
  extractionOutputHash String?   @map("extraction_output_hash")
  extractedAt          DateTime? @map("extracted_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  candidates ExtractionCandidate[]

  /// Target of ExtractionCandidate's composite key: a Candidate's Snapshot is its Batch's Snapshot.
  @@unique([id, sourceSnapshotId], map: "import_batches_id_snapshot_key")
  @@index([sourceSnapshotId], map: "import_batches_source_snapshot_id_idx")
  @@index([status], map: "import_batches_status_idx")
  @@index([reviewRulesetId], map: "import_batches_review_ruleset_id_idx")
  @@index([comparisonManifestId], map: "import_batches_comparison_manifest_id_idx")
  @@map("import_batches")
}

/// One immutable PROPOSED piece of extracted information (M3-WO2) — never authoritative game data, never an Entity.
/// Exactly one primary anchor (section OR content node, CHECK), of the Batch's Snapshot (composite keys).
/// `candidateFingerprint` (PROWESS_EXTRACTION_CANDIDATE_V1) excludes status, so review can never redefine identity.
model ExtractionCandidate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  importBatchId    String         @map("import_batch_id") @db.Uuid
  sourceSnapshotId String         @map("source_snapshot_id") @db.Uuid
  importBatch      ImportBatch    @relation(fields: [importBatchId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidates_batch_fkey")
  sourceSnapshot   SourceSnapshot @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidates_snapshot_fkey")

  ordinal Int

  candidateKind        ExtractionCandidateKind @map("candidate_kind")
  proposedEntityType   EntityType?             @map("proposed_entity_type")
  proposedCanonicalKey String?                 @map("proposed_canonical_key")

  displayLabel String  @map("display_label")
  summary      String?

  confidence ExtractionConfidence
  status     ExtractionCandidateStatus @default(UNREVIEWED)

  payloadSchemaKey     String @map("payload_schema_key")
  payloadSchemaVersion Int    @map("payload_schema_version")
  payloadJson          Json   @map("payload_json")

  candidateFingerprint String @map("candidate_fingerprint")

  primarySourceSectionId     String?            @map("primary_source_section_id") @db.Uuid
  primarySourceSection       SourceSection?     @relation(fields: [primarySourceSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidates_primary_section_fkey")
  primarySourceContentNodeId String?            @map("primary_source_content_node_id") @db.Uuid
  primarySourceContentNode   SourceContentNode? @relation(fields: [primarySourceContentNodeId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidates_primary_content_node_fkey")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  supportingSources ExtractionCandidateSource[]

  @@unique([importBatchId, ordinal], map: "extraction_candidates_batch_ordinal_key")
  @@unique([importBatchId, candidateFingerprint], map: "extraction_candidates_batch_fingerprint_key")
  /// Target of ExtractionCandidateSource's composite key.
  @@unique([id, sourceSnapshotId], map: "extraction_candidates_id_snapshot_key")
  @@index([status], map: "extraction_candidates_status_idx")
  @@index([confidence], map: "extraction_candidates_confidence_idx")
  @@index([candidateKind], map: "extraction_candidates_candidate_kind_idx")
  @@index([proposedEntityType], map: "extraction_candidates_proposed_entity_type_idx")
  @@map("extraction_candidates")
}

/// A SUPPORTING source anchor of a Candidate (M3-WO2): additional evidence, never another Candidate. Exactly one of
/// section / content node (CHECK), of the Candidate's Snapshot (composite keys). `excerpt`, when present, is verbatim
/// text of the anchored block / table (service-verified). No finer locator exists in the WO1 location model, so none
/// is stored; page numbers and offsets are never invented.
model ExtractionCandidateSource {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  extractionCandidateId String              @map("extraction_candidate_id") @db.Uuid
  sourceSnapshotId      String              @map("source_snapshot_id") @db.Uuid
  extractionCandidate   ExtractionCandidate @relation(fields: [extractionCandidateId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidate_sources_candidate_fkey")
  sourceSnapshot        SourceSnapshot      @relation(fields: [sourceSnapshotId], references: [id], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidate_sources_snapshot_fkey")

  sourceSectionId     String?            @map("source_section_id") @db.Uuid
  sourceSection       SourceSection?     @relation(fields: [sourceSectionId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidate_sources_section_fkey")
  sourceContentNodeId String?            @map("source_content_node_id") @db.Uuid
  sourceContentNode   SourceContentNode? @relation(fields: [sourceContentNodeId, sourceSnapshotId], references: [id, sourceSnapshotId], onDelete: Restrict, onUpdate: Cascade, map: "extraction_candidate_sources_content_node_fkey")

  ordinal Int
  excerpt String?

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([extractionCandidateId, ordinal], map: "extraction_candidate_sources_candidate_ordinal_key")
  @@map("extraction_candidate_sources")
}
