    {
      "canonicalKey": "affinity.evocation",
      "definitionKind": "AFFINITY",
      "schemaVersion": 2,
      "payload": {
        "affinity": "EVOCATION",
        "identity": {
          "text": "Evocation governs projected mana, force, direct output, destructive release, and battlefield pressure.",
          "themes": [
            "projection",
            "force",
            "direct output",
            "destructive release",
            "battlefield pressure"
          ]
        },
        "strengths": [
          {
            "strengthKey": "DIRECT_DAMAGE",
            "matchAny": [
              "keyword.direct_damage"
            ]
          },
          {
            "strengthKey": "AREA_EFFECT",
            "matchAny": [
              "keyword.area_effect"
            ]
          },
          {
            "strengthKey": "SUSTAINED_OR_CHANNELED_OUTPUT",
            "matchAny": [
              "keyword.sustained_output",
              "keyword.channeled_output"
            ]
          }
        ],
        "weaknesses": [
          {
            "weaknessKey": "HEALING",
            "matchAny": [
              "keyword.healing"
            ],
            "activationPenaltyPercent": 30,
            "severity": "MAJOR"
          },
          {
            "weaknessKey": "BUFF_OR_DEBUFF",
            "matchAny": [
              "keyword.buff",
              "keyword.debuff"
            ],
            "activationPenaltyPercent": 20,
            "severity": "MODERATE"
          },
          {
            "weaknessKey": "SUMMON_OR_CONSTRUCT",
            "matchAny": [
              "keyword.summon",
              "keyword.construct"
            ],
            "activationPenaltyPercent": 20,
            "severity": "MODERATE"
          }
        ],
