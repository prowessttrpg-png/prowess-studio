{
  "contentKey": "prowess.core_playtest.v0_1.targeting",
  "workOrder": "M5-WO6",
  "schemaVersion": 1,
  "source": {
    "title": "Prowess Core Playtest Packet V0.1",
    "sha256Prefix": "21fa6771",
    "parser": "prowess-docx-structure@1.0.0",
    "structureHashPrefix": "3d9a429c"
  },
  "designerRulings": [
    "M5-SC-016 Projectile is a canonical (Attack-Roll-oriented) Spell Targeting Type; Touch and Projectile deliver directly, Line / Cone / Radius / Zone deliver to an area — the Effect owns resolution",
    "M5-SC-018 Maneuver Radius = Martial Rank Base (Trained 5 · Expert 10 · Master 15 ft) × STR; the STR-band table is superseded",
    "M5-SC-015 / M5-SC-017 Targeting Conversion is a Maneuver Effect: it owns the conversion, Save Profile and cost; MANEUVER_TARGETING carries geometry only",
    "M5-SC-022 a Spell has one Targeting Type shared by every Effect",
    "M5-SC-024 the '+10 ft Radius / Zone / Aura → +3 MP' scaling is superseded; Widen Area (+6 MP) is a Targeting Trait for Targeting Types with a radius (not Line)",
    "M5-SC-029 Trigger-Based and Glyph / Anchor are Targeting add-ons, not base Targeting Types; their +4 / +5 MP source costs are superseded"
  ],
  "designerContent": "M5-WO6 §19–§99: the Spell Targeting catalog (Self, Touch, Single Target, Multi-Target, Projectile, Line, Cone, Radius, Zone, Aura), default Spell Range (= the WO2 BASE_RANGE statistic, 15 ft × PER), Spell areas, the Targeting scaling table without the superseded radius expansion, and the Maneuver Targeting geometry catalog (Self, Touch, Single Target, Multi-Target, Line, Cone, Radius, Chain, Zone).",
  "deferred": [
    {
      "conflictKey": "M5-SC-039",
      "subject": "spell.targeting.projectile",
      "field": "costContributions.targeting.base",
      "note": "Projectile Base MP cost is unresolved; the lower-authority Chapter Book value (2 MP) is not canon. Required by M5-WO10."
    },
    {
      "conflictKey": "M5-SC-040",
      "subject": "spell.targeting.line",
      "field": "rules.targeting.measures.WIDTH",
      "note": "Base Line width '5 ft wide per 2 Prowess' has no rounding / minimum rule; no width is emitted."
    }
  ],
