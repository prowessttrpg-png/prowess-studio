# Local development defaults. Safe to commit — these are non-secret,
# localhost-only placeholder values, not real credentials.
#
# Loaded automatically by Next.js (and by src/config/load.ts for non-Next
# tooling) when NODE_ENV=development. See .env.example for what each
# variable means, and .env.production.example for the production shape.

NODE_ENV=development
APP_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/prowess_studio_dev
LOG_LEVEL=debug

# Prowess Studio's own development/debug-mode toggle — distinct from
# NODE_ENV. Enabled here because this is the local development environment.
DEVELOPMENT_MODE=true
