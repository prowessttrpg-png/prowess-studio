# Production configuration template. This file is a reference only — it is
# NOT loaded automatically (Next.js only auto-loads .env.production, not
# .env.production.example). Real production values must come from your
# deployment platform's secret store, or a gitignored .env.production.local
# — never from a file committed to source control.

NODE_ENV=production
APP_URL=https://studio.example.com
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
LOG_LEVEL=info

# Independent of NODE_ENV — see .env.example for the full explanation.
# Off by default in production; a real deployment can still set this to
# "true" if internal debug tooling is genuinely needed there.
DEVELOPMENT_MODE=false
